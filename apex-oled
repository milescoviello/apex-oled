class Sink:
    """Where frames go: through apex-oledd if it is running, else the panel.

    The daemon owns the panel and redraws every tick, so a direct write would
    be overwritten within a frame. Routing through it as an expiring, top
    priority "notification" is what makes the CLI usable alongside the daemon.
    Use --direct to bypass (and fight it).
    """

    def __init__(self, args):
        self.args = args
        self.secs = getattr(args, 'notify', 5.0)
        self.dpy = None
        self.via_daemon = False
        if not getattr(args, 'direct', False):
            self.via_daemon = daemon_send({'cmd': 'status'}) is not None
        if not self.via_daemon:
            self.dpy = Display(args.device)

    def show(self, img, secs=None):
        if self.dpy is not None:
            self.dpy.show(img, invert=self.args.invert)
            return
        import base64
        daemon_send({'cmd': 'notify', 'secs': secs or self.secs,
                     'invert': self.args.invert,
                     'fb': base64.b64encode(pack(img)).decode()})

    def lines(self, lines, secs=None):
        self.show(render_text(lines, size=self.args.size, align=self.args.align),
                  secs=secs)

    def blank(self):
        if self.dpy is not None:
            self.dpy.blank()
        else:
            daemon_send({'cmd': 'clear'})

    def close(self):
        if self.dpy is not None:
            self.dpy.close()

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.close()


def cmd_text(sink, args):
    sink.lines(args.lines)


def cmd_image(sink, args):
    sink.show(Image.open(args.file))


def cmd_clear(sink, args):
    sink.blank()


def cmd_pipe(sink, args):
    """Stream stdin to the panel.

    lines  (default) - rolling tail, last N lines stay on screen
    frames           - a blank line flushes the accumulated lines as one frame
    """
    buf = []
    maxlines = args.lines_per_frame
    # Outlive one update so the frame does not lapse back to the daemon
    # between lines; a slow producer just refreshes it in time.
    hold = max(args.notify, 30.0)
    for raw in sys.stdin:
        line = raw.rstrip('\n')
        if args.mode == 'frames':
            if line == '':
                if buf:
                    sink.lines(buf[:maxlines], secs=hold)
                    buf = []
                continue
            buf.append(line)
        else:
            buf.append(line)
            buf = buf[-maxlines:]
            sink.lines(buf, secs=hold)
    if args.mode == 'frames' and buf:
        sink.lines(buf[:maxlines], secs=hold)


def cmd_marquee(sink, args):
    """Scroll a long string right-to-left until interrupted."""
    font, _ = load_font(args.size)
    text = args.text + '   ' + ('' if args.once else args.text)
    w = int(text_length(text, font)) + WIDTH
    strip = Image.new('1', (w, HEIGHT), 0)
    draw_string(ImageDraw.Draw(strip), (WIDTH, (HEIGHT - args.size) // 2),
                text, font)
    x = 0
    try:
        while True:
            sink.show(strip.crop((x, 0, x + WIDTH, HEIGHT)),
                      secs=max(args.delay * 4, 1.0))
            x += args.step
            if x + WIDTH >= w:
                if args.once:
                    break
                x = 0
            time.sleep(args.delay)
    except KeyboardInterrupt:
        pass


def cmd_watch(sink, args):
    """Re-run a shell command every N seconds and show its output."""
    import subprocess
    hold = max(args.interval * 3, 5.0)
    try:
        while True:
            out = subprocess.run(args.command, shell=True, capture_output=True,
                                 text=True).stdout.strip().splitlines()
            sink.lines(out[:args.lines_per_frame], secs=hold)
            time.sleep(args.interval)
    except KeyboardInterrupt:
        pass


def cmd_mode(sink, args):
    """Switch what the daemon shows. Needs the daemon; there is nothing to
    switch without it."""
    action = 'cycle' if args.cycle else f'mode:{args.name or "auto"}'
    reply = daemon_send({'cmd': 'action', 'action': action})
    if reply is None:
        sys.exit('apex-oled: daemon not running')
    print(f'mode: {reply.get("mode")}')


def cmd_blank(sink, args):
    reply = daemon_send({'cmd': 'action', 'action': 'blank'})
    if reply is None:
        sys.exit('apex-oled: daemon not running')
    print(f'panel: {"off" if reply.get("blanked") else "on"}')


def cmd_play(sink, args):
    """Play a stream of pre-packed 640-byte framebuffers.

    Frames are pushed straight to the panel rather than through the daemon:
    the daemon redraws on its own schedule, so animation has to own the
    device. It is asked to stand down for the duration (and told to resume
    afterwards, including on Ctrl-C) rather than being killed.
    """
    import signal as _signal
    data = open(args.file, 'rb').read()
    if len(data) % FB_LEN:
        sys.exit(f'apex-oled: {args.file} is not a whole number of '
                 f'{FB_LEN}-byte frames')
    frames = [data[i:i + FB_LEN] for i in range(0, len(data), FB_LEN)]
    if not frames:
        sys.exit('apex-oled: no frames')
    period = 1.0 / args.fps
    total = len(frames) * period
    print(f'{len(frames)} frames, {args.fps} fps, {total:.1f}s'
          f'{" (looping)" if args.loop else ""}')

    running = daemon_send({'cmd': 'status'}) is not None
    if running:
        daemon_send({'cmd': 'release', 'secs': total + 5 if not args.loop else 1800})

    def give_back(*_):
        if running:
            daemon_send({'cmd': 'resume'})
        sys.exit(0)
    for sig in (_signal.SIGINT, _signal.SIGTERM):
        _signal.signal(sig, give_back)

    dpy = Display(args.device)
    late = 0
    try:
        while True:
            start = time.monotonic()
            for i, fb in enumerate(frames):
                dpy.send(fb)
                # Absolute schedule, not sleep(period): per-frame sleeps
                # accumulate drift over thousands of frames.
                target = start + (i + 1) * period
                delay = target - time.monotonic()
                if delay > 0:
                    time.sleep(delay)
                else:
                    late += 1
            if not args.loop:
                break
            if running:
                daemon_send({'cmd': 'release', 'secs': 1800})
        dpy.blank()
    finally:
        dpy.close()
        if running:
            daemon_send({'cmd': 'resume'})
    if late:
        print(f'{late} frame(s) ran late ({late / len(frames) * 100:.1f}%)')


def cmd_info(sink, args):
    font, scalable = load_font(13)
    status = daemon_send({'cmd': 'status'})
    print(f'device      : {sink.dpy.path if sink.dpy else find_device()}')
    print(f'panel       : {WIDTH}x{HEIGHT}, 1bpp, page-major (SSD1306 order)')
    print(f'report      : {FB_LEN + 2}-byte feature report, cmd 0x{CMD:02X}')
    print(f'truetype    : {"yes" if scalable else "NO - Pillow lacks freetype; "
                           "run: euse -E truetype && emerge -1 dev-python/pillow"}')
    print(f'shaping     : {"raqm " + (features.version("raqm") or "") if RAQM else "none - Arabic unjoined, Indic marks misplaced; Pillow needs USE=raqm"}')
    if status and status.get('device_error'):
        # Daemon alive but with no panel to draw on - previously this was only
        # discoverable by reading the log.
        print(f'daemon      : running, but CANNOT REACH THE PANEL')
        print(f'              {status["device_error"]}')
    elif status:
        why = status.get('blank_reason')
        blanked = f' (blanked: {why})' if why else ' (blanked)'
        print(f'daemon      : running, showing {status.get("source")!r}'
              f'{blanked if status.get("blanked") else ""}')
        if status.get('forced_mode'):
            print(f'              PINNED to {status["forced_mode"]!r} - nothing '
                  f'else can take the screen')
            print("              release with: apex-oled mode auto")
        print(f'              active sources: {", ".join(status.get("sources", []))}')
        if 'afk' in status:             # absent from daemons that predate it
            afk = status['afk']
            if not afk:
                print('              afk blanking off (afk_minutes = 0)')
            elif not afk.get('watching'):
                print('              afk: never blanks - no readable input device '
                      '(not in the input group?)')
            else:
                print(f'              afk: dark after {afk["afk_after"] / 60:g} min '
                      f'without input; last input {afk["idle_for"]:.0f}s ago '
                      f'({afk["watching"]} devices)')
        print('              CLI frames route through it; --direct to bypass')
    else:
        print('daemon      : not running (CLI writes straight to the panel)')


def main():
    def add_common(parser, sub=False):
        """Shared options, accepted either before or after the subcommand.

        On subparsers the defaults are SUPPRESS, so an option left off there
        does not clobber a value already given on the main parser.
        """
        d = (lambda v: argparse.SUPPRESS) if sub else (lambda v: v)
        parser.add_argument('--device', default=d(None),
                            help='hidraw node to use (default: autodetect)')
        parser.add_argument('--invert', action='store_true', default=d(False),
                            help='white background')
        parser.add_argument('--size', type=int, default=d(13),
                            help='font size (needs Pillow truetype)')
        parser.add_argument('--align', default=d('left'),
                            choices=['left', 'center', 'right'])
        parser.add_argument('--lines-per-frame', type=int, default=d(3), metavar='N')
        parser.add_argument('--notify', type=float, default=d(5.0), metavar='SECS',
                            help='how long a frame holds the screen when the '
                                 'daemon is running (default 5)')
        parser.add_argument('--direct', action='store_true', default=d(False),
                            help='write straight to the panel, bypassing the '
                                 'daemon (they will fight over it)')

    p = argparse.ArgumentParser(
        prog='apex-oled',
        description='Drive the OLED on a SteelSeries Apex Pro Gen 3.')
    add_common(p)
    sub = p.add_subparsers(dest='cmd', required=True)

    def add(name, help, func):
        s = sub.add_parser(name, help=help)
        add_common(s, sub=True)
        s.set_defaults(func=func)
        return s

    add('text', 'show one or more lines', cmd_text).add_argument('lines', nargs='+')

    add('image', 'show an image file (dithered)', cmd_image).add_argument('file')

    add('clear', 'blank the screen', cmd_clear)

    add('pipe', 'stream stdin to the screen', cmd_pipe).add_argument(
        '--mode', default='lines', choices=['lines', 'frames'])

    s = add('marquee', 'scroll long text', cmd_marquee)
    s.add_argument('text')
    s.add_argument('--delay', type=float, default=0.03)
    s.add_argument('--step', type=int, default=2)
    s.add_argument('--once', action='store_true')

    s = add('watch', 'repeatedly run a command and show its output', cmd_watch)
    s.add_argument('command')
    s.add_argument('--interval', type=float, default=2.0)

    s = add('mode', 'switch which view the daemon shows', cmd_mode)
    s.add_argument('name', nargs='?',
                   help='idle | lyrics | qwen | game | auto')
    s.add_argument('--cycle', action='store_true', help='step to the next mode')

    add('blank', 'toggle the panel off/on', cmd_blank)

    s = add('play', 'play packed 640-byte frames (see tools/video2fb)', cmd_play)
    s.add_argument('file')
    s.add_argument('--fps', type=float, default=30.0)
    s.add_argument('--loop', action='store_true')

    add('info', 'report device and capabilities', cmd_info)

    args = p.parse_args()
    try:
        with Sink(args) as sink:
            args.func(sink, args)
    except RuntimeError as e:
        sys.exit(f'apex-oled: {e}')


if __name__ == '__main__':
    main()
