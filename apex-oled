#!/usr/bin/env python3
"""apex-oled - drive the 128x40 OLED on a SteelSeries Apex Pro Gen 3.

Usable as a CLI or as a library:

    from importlib.machinery import SourceFileLoader
    apex = SourceFileLoader('apex', '/path/to/apex-oled').load_module()
    with apex.Display() as d:
        d.text('hello', 'world')
        d.show(some_pil_image)

Protocol notes (reverse-engineered, confirmed on this keyboard 2026-08-12)
-------------------------------------------------------------------------
The keyboard exposes 5 HID interfaces. Interface 1 (vendor usage page 0xFFC0)
declares a 642-byte FEATURE report - that is the screen:

    642 bytes = [0x61] + 640 bytes framebuffer + [0x00]

The framebuffer is 128x40 1bpp in SSD1306 *page-major* order: 5 pages of 128
columns, one byte per column, where bit N of the byte is the pixel at
y = page*8 + N. Plain row-major packing renders as garbage - that was the
first thing tried and it is wrong.

Delivery is a SET_REPORT control transfer, done here with the HIDIOCSFEATURE
ioctl straight on /dev/hidrawN, so no hidapi dependency is needed. hidraw
expects a leading report-number byte, which is 0 because this descriptor
declares no report IDs; the kernel strips it before the transfer.
"""
import argparse
import fcntl
import glob
import json
import os
import socket
import sys
import time

from PIL import Image, ImageDraw, ImageFont

SOCKET_PATH = os.path.join(os.environ.get('XDG_RUNTIME_DIR', '/tmp'),
                           'apex-oledd.sock')

VENDOR, PRODUCT = 0x1038, 0x1640
WIDTH, HEIGHT = 128, 40
PAGES = HEIGHT // 8
FB_LEN = WIDTH * PAGES              # 640
CMD = 0x61

# Signature of the right interface: vendor page 0xFFC0 + a 642-byte feature
# report (usage 0xF2, Report Count 0x0282).
_DESC_PREFIX = bytes([0x06, 0xC0, 0xFF])
_DESC_FEATURE = bytes([0x09, 0xF2, 0x96, 0x82, 0x02, 0xB1, 0x02])

FONT_DIRS = ['/usr/share/fonts/dejavu']


def _ioc(direction, typ, nr, size):
    return (direction << 30) | (size << 16) | (typ << 8) | nr


def _hidiocsfeature(size):
    return _ioc(3, ord('H'), 0x06, size)


def find_device():
    """Path of the hidraw node that carries the framebuffer, or None."""
    for sysdir in sorted(glob.glob('/sys/class/hidraw/hidraw*')):
        try:
            with open(sysdir + '/device/uevent') as f:
                uevent = f.read()
            with open(sysdir + '/device/report_descriptor', 'rb') as f:
                desc = f.read()
        except OSError:
            continue
        if f'HID_ID=0003:{VENDOR:08X}:{PRODUCT:08X}' not in uevent.upper():
            continue
        if desc.startswith(_DESC_PREFIX) and _DESC_FEATURE in desc:
            return '/dev/' + os.path.basename(sysdir)
    return None


_BITREV = bytes(int(format(i, '08b')[::-1], 2) for i in range(256))
_TRANSPOSE = getattr(Image, 'Transpose', Image).TRANSPOSE


def _to_1bit(img):
    if img.size != (WIDTH, HEIGHT):
        img = img.resize((WIDTH, HEIGHT), Image.LANCZOS)
    if img.mode != '1':
        img = img.convert('1')          # Floyd-Steinberg dither
    return img


def pack(img):
    """PIL image -> 640-byte page-major framebuffer.

    Accepts any mode/size; resizes and dithers to 1bpp as needed.

    Done with PIL primitives rather than a per-pixel loop, since the daemon
    renders continuously. Transposing makes each source *column* a row, so
    PIL's own 1bpp packing does the vertical bit-packing for us: HEIGHT is 40,
    exactly 5 bytes per transposed row, so there is no row padding to strip.
    """
    img = _to_1bit(img)
    # PIL packs MSB-first (bit 7 = topmost pixel of the page); the panel wants
    # bit 0 = topmost, so reverse the bits within every byte.
    raw = img.transpose(_TRANSPOSE).tobytes().translate(_BITREV)
    # raw is indexed [x*PAGES + page]; the panel wants [page*WIDTH + x].
    return b''.join(raw[p::PAGES] for p in range(PAGES))


def unpack(framebuffer):
    """Inverse of pack(): a 640-byte page-major framebuffer -> 1bpp image.

    Used to accept client-rendered frames over IPC, and as a round-trip check
    on pack(). _BITREV is its own inverse, so the same table undoes it.
    """
    if len(framebuffer) != FB_LEN:
        raise ValueError(f'framebuffer must be {FB_LEN} bytes, got {len(framebuffer)}')
    raw = bytearray(FB_LEN)
    for p in range(PAGES):
        raw[p::PAGES] = framebuffer[p * WIDTH:(p + 1) * WIDTH]
    img = Image.frombytes('1', (HEIGHT, WIDTH), bytes(raw).translate(_BITREV))
    return img.transpose(_TRANSPOSE)


def pack_reference(img):
    """Slow, obvious version of pack(). Kept as the correctness oracle."""
    img = _to_1bit(img)
    px = img.load()
    fb = bytearray(FB_LEN)
    for page in range(PAGES):
        base, top = page * WIDTH, page * 8
        for x in range(WIDTH):
            b = 0
            for bit in range(8):
                if px[x, top + bit]:
                    b |= 1 << bit
            fb[base + x] = b
    return bytes(fb)


def load_font(size):
    """Truetype at `size` if Pillow has freetype, else the bundled bitmap font.

    Gentoo's dev-python/pillow needs USE=truetype for the good path;
    without it this silently falls back and `size` is ignored.
    """
    try:
        for d in FONT_DIRS:
            for name in ('DejaVuSansCondensed-Bold.ttf', 'DejaVuSans-Bold.ttf'):
                p = os.path.join(d, name)
                if os.path.exists(p):
                    return ImageFont.truetype(p, size), True
    except (OSError, ImportError):
        pass
    return ImageFont.load_default(), False


def render_text(lines, size=13, align='left'):
    """Lay out a few short lines into a 128x40 frame, vertically centred."""
    img = Image.new('1', (WIDTH, HEIGHT), 0)
    d = ImageDraw.Draw(img)
    font, scalable = load_font(size)
    lines = [str(x) for x in lines if x is not None]
    if not lines:
        return img
    lh = (font.getbbox('Ay')[3] + 2) if scalable else 13
    y = max(0, (HEIGHT - lh * len(lines)) // 2)
    for line in lines:
        w = d.textlength(line, font=font)
        x = {'left': 2, 'center': (WIDTH - w) // 2, 'right': WIDTH - w - 2}[align]
        d.text((max(0, x), y), line, font=font, fill=1)
        y += lh
    return img


def daemon_send(msg, timeout=2.0):
    """Send one JSON command to apex-oledd. Returns its reply, or None.

    None means no daemon is listening, in which case callers should just
    write to the panel directly.
    """
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(SOCKET_PATH)
        s.sendall((json.dumps(msg) + '\n').encode())
        data = b''
        while b'\n' not in data and len(data) < 65536:
            chunk = s.recv(4096)
            if not chunk:
                break
            data += chunk
        return json.loads(data.decode() or '{}')
    except (OSError, ValueError):
        return None
    finally:
        s.close()


class Display:
    """The keyboard's OLED panel."""

    def __init__(self, path=None):
        self.path = path or find_device()
        if self.path is None:
            raise RuntimeError(
                'No Apex Pro Gen 3 OLED interface found - is the keyboard connected?')
        try:
            self.fd = os.open(self.path, os.O_WRONLY)
        except PermissionError:
            raise RuntimeError(
                f'Cannot open {self.path}. Install the udev rule at '
                '/etc/udev/rules.d/99-steelseries-apex-oled.rules, or run as root.')

    def send(self, framebuffer):
        """Push a raw 640-byte page-major framebuffer."""
        if len(framebuffer) != FB_LEN:
            raise ValueError(f'framebuffer must be {FB_LEN} bytes, got {len(framebuffer)}')
        buf = bytearray(b'\x00' + bytes([CMD]) + framebuffer + b'\x00')
        fcntl.ioctl(self.fd, _hidiocsfeature(len(buf)), buf)

    def show(self, img, invert=False):
        """Render a PIL image to the panel."""
        if invert:
            img = img.convert('L').point(lambda p: 255 - p)
        self.send(pack(img))

    def blank(self):
        self.send(bytes(FB_LEN))

    def text(self, *lines, size=13, align='left', invert=False):
        """Render up to a few short lines of text, vertically centred."""
        self.show(render_text(lines, size=size, align=align), invert=invert)

    def close(self):
        if getattr(self, 'fd', None) is not None:
            os.close(self.fd)
            self.fd = None

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.close()


