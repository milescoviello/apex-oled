#!/usr/bin/env python3
"""apex-oled - drive the 128x40 OLED on a SteelSeries Apex Pro Gen 3.

Usable as a CLI or as a library:

    from importlib.machinery import SourceFileLoader
    apex = SourceFileLoader('apex', '/path/to/apex-oled').load_module()
    with apex.Display() as d:
        d.text('hello', 'world')
        d.show(some_pil_image)

Protocol notes (reverse-engineered, confirmed on this keyboard 2026-08-12)
-------------------------------------------------------------------------
The keyboard exposes 5 HID interfaces. Interface 1 (vendor usage page 0xFFC0)
declares a 642-byte FEATURE report - that is the screen:

    642 bytes = [0x61] + 640 bytes framebuffer + [0x00]

The framebuffer is 128x40 1bpp in SSD1306 *page-major* order: 5 pages of 128
columns, one byte per column, where bit N of the byte is the pixel at
y = page*8 + N. Plain row-major packing renders as garbage - that was the
first thing tried and it is wrong.

Delivery is a SET_REPORT control transfer, done here with the HIDIOCSFEATURE
ioctl straight on /dev/hidrawN, so no hidapi dependency is needed. hidraw
expects a leading report-number byte, which is 0 because this descriptor
declares no report IDs; the kernel strips it before the transfer.
"""
import argparse
import bisect
import fcntl
import glob
import json
import os
import socket
import subprocess
import sys
import time
import unicodedata

from PIL import Image, ImageDraw, ImageFont, features

SOCKET_PATH = os.path.join(os.environ.get('XDG_RUNTIME_DIR', '/tmp'),
                           'apex-oledd.sock')

VENDOR, PRODUCT = 0x1038, 0x1640
WIDTH, HEIGHT = 128, 40
PAGES = HEIGHT // 8
FB_LEN = WIDTH * PAGES              # 640
CMD = 0x61

# Signature of the right interface: vendor page 0xFFC0 + a 642-byte feature
# report (usage 0xF2, Report Count 0x0282).
_DESC_PREFIX = bytes([0x06, 0xC0, 0xFF])
_DESC_FEATURE = bytes([0x09, 0xF2, 0x96, 0x82, 0x02, 0xB1, 0x02])

FONT_DIRS = ['/usr/share/fonts/dejavu']


def _ioc(direction, typ, nr, size):
    return (direction << 30) | (size << 16) | (typ << 8) | nr


def _hidiocsfeature(size):
    return _ioc(3, ord('H'), 0x06, size)


def find_device():
    """Path of the hidraw node that carries the framebuffer, or None."""
    for sysdir in sorted(glob.glob('/sys/class/hidraw/hidraw*')):
        try:
            with open(sysdir + '/device/uevent') as f:
                uevent = f.read()
            with open(sysdir + '/device/report_descriptor', 'rb') as f:
                desc = f.read()
        except OSError:
            continue
        if f'HID_ID=0003:{VENDOR:08X}:{PRODUCT:08X}' not in uevent.upper():
            continue
        if desc.startswith(_DESC_PREFIX) and _DESC_FEATURE in desc:
            return '/dev/' + os.path.basename(sysdir)
    return None


_BITREV = bytes(int(format(i, '08b')[::-1], 2) for i in range(256))
_TRANSPOSE = getattr(Image, 'Transpose', Image).TRANSPOSE


def _to_1bit(img):
    if img.size != (WIDTH, HEIGHT):
        img = img.resize((WIDTH, HEIGHT), Image.LANCZOS)
    if img.mode != '1':
        img = img.convert('1')          # Floyd-Steinberg dither
    return img


def pack(img):
    """PIL image -> 640-byte page-major framebuffer.

    Accepts any mode/size; resizes and dithers to 1bpp as needed.

    Done with PIL primitives rather than a per-pixel loop, since the daemon
    renders continuously. Transposing makes each source *column* a row, so
    PIL's own 1bpp packing does the vertical bit-packing for us: HEIGHT is 40,
    exactly 5 bytes per transposed row, so there is no row padding to strip.
    """
    img = _to_1bit(img)
    # PIL packs MSB-first (bit 7 = topmost pixel of the page); the panel wants
    # bit 0 = topmost, so reverse the bits within every byte.
    raw = img.transpose(_TRANSPOSE).tobytes().translate(_BITREV)
    # raw is indexed [x*PAGES + page]; the panel wants [page*WIDTH + x].
    return b''.join(raw[p::PAGES] for p in range(PAGES))


def unpack(framebuffer):
    """Inverse of pack(): a 640-byte page-major framebuffer -> 1bpp image.

    Used to accept client-rendered frames over IPC, and as a round-trip check
    on pack(). _BITREV is its own inverse, so the same table undoes it.
    """
    if len(framebuffer) != FB_LEN:
        raise ValueError(f'framebuffer must be {FB_LEN} bytes, got {len(framebuffer)}')
    raw = bytearray(FB_LEN)
    for p in range(PAGES):
        raw[p::PAGES] = framebuffer[p * WIDTH:(p + 1) * WIDTH]
    img = Image.frombytes('1', (HEIGHT, WIDTH), bytes(raw).translate(_BITREV))
    return img.transpose(_TRANSPOSE)


def pack_reference(img):
    """Slow, obvious version of pack(). Kept as the correctness oracle."""
    img = _to_1bit(img)
    px = img.load()
    fb = bytearray(FB_LEN)
    for page in range(PAGES):
        base, top = page * WIDTH, page * 8
        for x in range(WIDTH):
            b = 0
            for bit in range(8):
                if px[x, top + bit]:
                    b |= 1 << bit
            fb[base + x] = b
    return bytes(fb)


# ---------------------------------------------------------------------------
# text in any script
# ---------------------------------------------------------------------------
#
# DejaVu has no CJK, Thai, Devanagari or emoji, and Pillow does no font
# fallback of its own: a character the font lacks draws as an empty box. So a
# FontChain picks a face per character - the primary, then the preferred
# fallbacks, then whatever fontconfig ranks next - and draws the runs on the
# primary's baseline.

# Order matters for Han characters, which Japanese, Chinese and Korean share
# but draw differently: the first CJK face listed decides their shapes.
FALLBACK_FAMILIES = ['Noto Sans CJK JP', 'Noto Emoji']

# With libraqm, Pillow shapes text (Arabic joining, Indic vowel reordering)
# and runs the bidi algorithm. Without it, glyphs are placed one by one, and
# right-to-left runs are reversed here instead - readable for Hebrew, but
# Arabic letters stay unjoined.
RAQM = features.check('raqm')

_FC_FMT = '%{file}\t%{index}\t%{scalable}\t%{color}\t%{charset}\n'


def _parse_charset(spec):
    """fontconfig's '%{charset}' ('20-7e a0-17f 3000') -> sorted ranges."""
    ranges = []
    for tok in spec.split():
        lo, _, hi = tok.partition('-')
        ranges.append((int(lo, 16), int(hi or lo, 16)))
    return ranges


class _Face:
    """One font file (and face index), what it covers, and its sizes."""

    def __init__(self, path, index=0, charset=None):
        self.path, self.index = path, index
        self._charset = charset     # parsed on first use: thousands are listed
        self._lo = self._hi = None
        self._sizes = {}

    def has(self, cp):
        if self._lo is None:
            ranges = (_parse_charset(self._charset) if self._charset is not None
                      else [(0, 0x10FFFF)])
            self._lo = [r[0] for r in ranges]
            self._hi = [r[1] for r in ranges]
        i = bisect.bisect_right(self._lo, cp) - 1
        return i >= 0 and cp <= self._hi[i]

    def at(self, size):
        font = self._sizes.get(size)
        if font is None:
            font = self._sizes[size] = ImageFont.truetype(
                self.path, size, index=self.index)
        return font


def _fc_faces(argv):
    try:
        out = subprocess.run(argv, capture_output=True, text=True,
                             timeout=15).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    faces = []
    for line in out.splitlines():
        parts = line.split('\t')
        if len(parts) != 5:
            continue
        path, index, scalable, color, charset = parts
        # Bitmap-only faces and colour emoji come in fixed strikes (Noto Color
        # Emoji is 109px only) that Pillow will not scale to a 10px line.
        if scalable == 'False' or color == 'True':
            continue
        try:
            faces.append(_Face(path, int(index), charset))
        except ValueError:
            continue
    return faces


class _Faces:
    """Every face a chain may use, shared across sizes; one per primary."""
    _registry = {}

    @classmethod
    def get(cls, primary, fallbacks):
        key = (primary, tuple(fallbacks))
        if key not in cls._registry:
            cls._registry[key] = cls(primary, fallbacks)
        return cls._registry[key]

    def __init__(self, primary, fallbacks):
        found = _fc_faces(['fc-query', '--index', '0', '--format', _FC_FMT,
                           primary])
        # No fontconfig: trust the primary for everything, as before.
        self.primary = found[0] if found else _Face(primary)
        self.chain = [self.primary]
        seen = {(self.primary.path, self.primary.index)}
        for family in fallbacks:
            for face in _fc_faces(['fc-match', '--format', _FC_FMT, family]):
                if (face.path, face.index) not in seen:
                    seen.add((face.path, face.index))
                    self.chain.append(face)
        self._seen = seen
        self._rest = None       # fontconfig's full ranking, fetched on demand
        self._cache = {}

    def face_of(self, cp):
        face = self._cache.get(cp)
        if face is None:
            face = self._cache[cp] = self._find(cp)
        return face

    def _find(self, cp):
        for face in self.chain:
            if face.has(cp):
                return face
        if self._rest is None:
            # Lazy: only text outside the primary and preferred faces pays
            # for listing every installed font.
            # -a, not -s: -s trims every font that adds no new coverage, which
            # drops Noto Sans Thai because FreeSerif already covered Thai.
            rest = [f for f in _fc_faces(['fc-match', '-a', '--format',
                                          _FC_FMT, 'sans-serif'])
                    if (f.path, f.index) not in self._seen]
            # fontconfig ranks catch-all fonts (FreeSans, FreeSerif) ahead of
            # the per-script Noto Sans faces, which drew Thai in a serif. The
            # sort is stable, so fontconfig's order holds within each group.
            self._rest = sorted(rest, key=lambda f: not _noto_sans(f.path))
        for face in self._rest:
            if face.has(cp):
                return face
        return self.primary     # nothing has it: an honest box


def _noto_sans(path):
    name = os.path.basename(path)
    return name.startswith('NotoSans') and 'Mono' not in name


def _is_mark(ch):
    """Joins the previous character: accents, vowel signs, emoji modifiers."""
    cp = ord(ch)
    return (unicodedata.category(ch) in ('Mn', 'Mc', 'Me')
            or cp in (0x200C, 0x200D)                   # ZWNJ, ZWJ
            or 0x1F3FB <= cp <= 0x1F3FF                 # skin tones
            or 0xE0020 <= cp <= 0xE007F)                # emoji tag sequences


def _is_regional(ch):
    return 0x1F1E6 <= ord(ch) <= 0x1F1FF


def clusters(s):
    """Split into user-perceived characters, approximately.

    A base plus its combining marks must land in the same font and must never
    be split by a line break or a truncation: a Devanagari vowel sign or a
    Thai tone mark on its own is a different, broken string.
    """
    out = []
    glue = False
    for ch in s:
        if out and (glue or _is_mark(ch)
                    or (_is_regional(ch) and len(out[-1]) == 1
                        and _is_regional(out[-1]))):
            out[-1] += ch
        else:
            out.append(ch)
        glue = ch == '\u200d'          # ZWJ glues the next character on too
    return out


_MIRROR = dict(zip('()[]{}<>\u00ab\u00bb', ')(][}{><\u00bb\u00ab'))


def _strong(cluster):
    d = unicodedata.bidirectional(cluster[0])
    if d in ('R', 'AL'):
        return 'R'
    if d in ('L', 'EN', 'AN'):          # numbers read left-to-right everywhere
        return 'L'
    return None


def _direction(rtl):
    return {'direction': 'rtl'} if rtl else {}


def visual_runs(s, faces):
    """(text, face, rtl) runs in left-to-right display order.

    A two-level bidi: enough to put right-to-left words in order and place
    them correctly among left-to-right ones, which is all a lyric line needs.
    """
    cl = clusters(s)
    dirs = [_strong(c) for c in cl]
    para = next((d for d in dirs if d), 'L')
    # Neutrals (spaces, punctuation) take their neighbours' direction when
    # both agree, else the paragraph's.
    res = list(dirs)
    i = 0
    while i < len(cl):
        if dirs[i] is not None:
            i += 1
            continue
        j = i
        while j < len(cl) and dirs[j] is None:
            j += 1
        prev = res[i - 1] if i else para
        nxt = dirs[j] if j < len(cl) else para
        for k in range(i, j):
            res[k] = prev if prev == nxt else para
        i = j
    druns = []
    for c, d in zip(cl, res):
        if druns and druns[-1][1] == d:
            druns[-1][0].append(c)
        else:
            druns.append(([c], d))
    if para == 'R':
        druns.reverse()
    out = []
    for cs, d in druns:
        rtl = d == 'R'
        if rtl and not RAQM:
            cs = [_MIRROR.get(c, c) for c in reversed(cs)]
        runs = []
        for c in cs:
            face = faces.face_of(ord(c[0]))
            # A mark the chosen face lacks would draw as a box after the base
            # (a variation selector after an emoji, say); drop it instead.
            c = c[0] + ''.join(m for m in c[1:] if face.has(ord(m)))
            if runs and runs[-1][1] is face:
                runs[-1][0] += c
            else:
                runs.append([c, face])
        if rtl and RAQM:
            runs.reverse()              # raqm reverses within each run itself
        out += [(t, face, rtl and RAQM) for t, face in runs]
    return out


class FontChain:
    """A font that falls back per character, so any script renders.

    Quacks enough like an ImageFont for the layout code: getmetrics(),
    getlength(), getbbox(), plus draw() in place of ImageDraw.text().
    Metrics are the primary's, so adding a fallback never moves a layout.
    """

    def __init__(self, path, size, fallbacks=None):
        self.faces = _Faces.get(path, FALLBACK_FAMILIES if fallbacks is None
                                else fallbacks)
        self.size = size
        self.primary = self.faces.primary.at(size)
        self._ascent = self.primary.getmetrics()[0]
        self._widths = {}

    def getmetrics(self):
        return self.primary.getmetrics()

    def runs(self, s):
        return [(t, face.at(self.size), rtl)
                for t, face, rtl in visual_runs(s, self.faces)]

    def getlength(self, s):
        w = self._widths.get(s)
        if w is None:
            w = sum(font.getlength(t, **_direction(rtl))
                    for t, font, rtl in self.runs(s))
            if len(self._widths) > 4096:
                self._widths.clear()
            self._widths[s] = w
        return w

    def getbbox(self, s):
        """Ink box relative to the top-left draw() origin, like ImageFont's."""
        x, box = 0.0, None
        for t, font, rtl in self.runs(s):
            b = font.getbbox(t, anchor='ls', **_direction(rtl))
            b = (x + b[0], self._ascent + b[1], x + b[2], self._ascent + b[3])
            box = b if box is None else (min(box[0], b[0]), min(box[1], b[1]),
                                         max(box[2], b[2]), max(box[3], b[3]))
            x += font.getlength(t, **_direction(rtl))
        return tuple(int(round(v)) for v in box) if box else (0, 0, 0, 0)

    def draw(self, draw, xy, s, fill=1):
        # Every run sits on the primary's baseline; each face's own ascender
        # differs, so the default top-left anchor would stagger them.
        x, y = xy
        base = y + self._ascent
        for t, font, rtl in self.runs(s):
            draw.text((x, base), t, font=font, fill=fill, anchor='ls',
                      **_direction(rtl))
            x += font.getlength(t, **_direction(rtl))


_probe = ImageDraw.Draw(Image.new('1', (1, 1)))


def text_length(s, font):
    if isinstance(font, FontChain):
        return font.getlength(s)
    return _probe.textlength(s, font=font)


def draw_string(draw, xy, s, font, fill=1):
    if isinstance(font, FontChain):
        font.draw(draw, xy, s, fill)
    else:
        draw.text(xy, s, font=font, fill=fill)


def load_font(size):
    """A FontChain at `size` if Pillow has freetype, else the bitmap font.

    Gentoo's dev-python/pillow needs USE=truetype for the good path;
    without it this silently falls back and `size` is ignored.
    """
    try:
        for d in FONT_DIRS:
            for name in ('DejaVuSansCondensed-Bold.ttf', 'DejaVuSans-Bold.ttf'):
                p = os.path.join(d, name)
                if os.path.exists(p):
                    return FontChain(p, size), True
    except (OSError, ImportError):
        pass
    return ImageFont.load_default(), False


def render_text(lines, size=13, align='left'):
    """Lay out a few short lines into a 128x40 frame, vertically centred."""
    img = Image.new('1', (WIDTH, HEIGHT), 0)
    d = ImageDraw.Draw(img)
    font, scalable = load_font(size)
    lines = [str(x) for x in lines if x is not None]
    if not lines:
        return img
    lh = (font.getbbox('Ay')[3] + 2) if scalable else 13
    y = max(0, (HEIGHT - lh * len(lines)) // 2)
    for line in lines:
        w = text_length(line, font)
        x = {'left': 2, 'center': (WIDTH - w) // 2, 'right': WIDTH - w - 2}[align]
        draw_string(d, (max(0, x), y), line, font)
        y += lh
    return img


def daemon_send(msg, timeout=2.0):
    """Send one JSON command to apex-oledd. Returns its reply, or None.

    None means no daemon is listening, in which case callers should just
    write to the panel directly.
    """
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(SOCKET_PATH)
        s.sendall((json.dumps(msg) + '\n').encode())
        data = b''
        while b'\n' not in data and len(data) < 65536:
            chunk = s.recv(4096)
            if not chunk:
                break
            data += chunk
        return json.loads(data.decode() or '{}')
    except (OSError, ValueError):
        return None
    finally:
        s.close()


class Display:
    """The keyboard's OLED panel."""

    def __init__(self, path=None):
        self.path = path or find_device()
        if self.path is None:
            raise RuntimeError(
                'No Apex Pro Gen 3 OLED interface found - is the keyboard connected?')
        try:
            self.fd = os.open(self.path, os.O_WRONLY)
        except PermissionError:
            raise RuntimeError(
                f'Cannot open {self.path}. Install the udev rule at '
                '/etc/udev/rules.d/99-steelseries-apex-oled.rules, or run as root.')

    def send(self, framebuffer):
        """Push a raw 640-byte page-major framebuffer."""
        if len(framebuffer) != FB_LEN:
            raise ValueError(f'framebuffer must be {FB_LEN} bytes, got {len(framebuffer)}')
        buf = bytearray(b'\x00' + bytes([CMD]) + framebuffer + b'\x00')
        fcntl.ioctl(self.fd, _hidiocsfeature(len(buf)), buf)

    def show(self, img, invert=False):
        """Render a PIL image to the panel."""
        if invert:
            img = img.convert('L').point(lambda p: 255 - p)
        self.send(pack(img))

    def blank(self):
        self.send(bytes(FB_LEN))

    def text(self, *lines, size=13, align='left', invert=False):
        """Render up to a few short lines of text, vertically centred."""
        self.show(render_text(lines, size=size, align=align), invert=invert)

    def close(self):
        if getattr(self, 'fd', None) is not None:
            os.close(self.fd)
            self.fd = None

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.close()


