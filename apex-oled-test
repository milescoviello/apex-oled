@check('hotkey actions cycle, pin and blank')
def t_hotkey_actions():
    import threading
    from PIL import Image
    ctx = _Ctx()
    ctx.stop = threading.Event()
    ctx.stop.set()
    ctx.forced_mode, ctx.blank_override = None, False
    ctx.render_lines = lambda *a, **k: Image.new('1', (W, H), 0)
    ctx.notify = oledd.NotifySource(ctx)

    class Fake:
        def __init__(self, n):
            self.name = n
    ctx.sources = [ctx.notify] + [Fake(n) for n in ('game', 'qwen', 'lyrics', 'idle')]
    h = oledd.make_action_handler(ctx)

    seen = []
    for _ in range(6):
        h('cycle')
        seen.append(ctx.forced_mode)
    # cycles through every mode and returns to auto (None)
    eq(seen, ['idle', 'lyrics', 'qwen', 'game', None, 'idle'], 'cycle order')

    h('mode:lyrics')
    eq(ctx.forced_mode, 'lyrics', 'pin a mode')
    h('mode:auto')
    eq(ctx.forced_mode, None, 'back to auto')
    h('blank')
    eq(ctx.blank_override, True, 'blank on')
    h('blank')
    eq(ctx.blank_override, False, 'blank off')
    h('nonsense')                       # must not raise
    eq(ctx.forced_mode, None, 'unknown action changes nothing')
    # pinning a mode clears a manual blank, so the panel cannot get stuck dark
    ctx.blank_override = True
    h('mode:idle')
    eq(ctx.blank_override, False, 'pinning a mode unblanks')


