    eq(runs[0][0], '2', 'RTL paragraph: the trailing number sits leftmost')


@check('lines without spaces wrap, obeying Japanese kinsoku')
def t_wrap_unspaced():
    font = oledd.Fonts(oledd.load_config('/nonexistent')).get(12)
    eq(oledd.break_units('Blow by blow'),
       [('Blow', ''), ('by', ' '), ('blow', ' ')], 'spaced text unchanged')
    units = oledd.break_units('「孤独」ギターと、ヒーロー')
    for u, _ in units[1:]:
        if u[0] in oledd._NO_BREAK_BEFORE:
            raise AssertionError(f'a line could start with {u[0]!r}: {units}')
    for u, _ in units[:-1]:
        if u[-1] in oledd._NO_BREAK_AFTER:
            raise AssertionError(f'a line could end with {u[-1]!r}: {units}')
    line = '踏みつけられた孤独とペダルから、何度も鳴り響く音色が頬に伝う'
    rows = oledd.wrap(line, W - 4, font, lines=3)
    if rows is None:
        raise AssertionError('a long Japanese line did not wrap at all')
    eq(''.join(rows), line, 'no characters lost or added')
    for r in rows:
        if oledd.text_width(r, font) > W - 4:
            raise AssertionError(f'row too wide: {r}')
    # Korean is spaced: it breaks between words, never inside one.
    ko = '이 밤 그날의 반딧불을 당신의 창 가까이 보낼게요'
    eq(' '.join(oledd.wrap(ko, W - 4, font, lines=3) or []), ko, 'Korean by word')


@check('truncation never strands a vowel sign from its letter')
def t_fit_clusters():
    font = oledd.Fonts(oledd.load_config('/nonexistent')).get(12)
    s = 'हम तेरे बिन अब रह नहीं सकते ' * 3
    for avail in range(20, 120, 7):
        out = oledd.fit(s, avail, font)
        if not out.endswith('..'):
            continue
        kept = out[:-2]
        nxt = s[len(kept.rstrip()):][:1] if s.startswith(kept.rstrip()) else ''
        if nxt and apex._is_mark(nxt):
            raise AssertionError(f'cut before a mark at {avail}px: {out!r}')


_MANGO_HEAD = ('os,cpu,gpu,ram,kernel,driver,cpuscheduler\n'
               'Gentoo,Ultra 9,RTX 5090,32GB,7.2.8,595,\n'
               'fps,frametime,cpu_load,cpu_power,gpu_load,cpu_temp,gpu_temp,'
               'gpu_core_clock,gpu_mem_clock,gpu_vram_used,gpu_power,ram_used,'
               'swap_used,process_rss,elapsed\n')


def _mango_row(fps):
    return f'{fps},6.9,40,80,98,81,66,2400,12000,9.1,140,18.2,0.1,4.2,1234\n'


@check('MangoHudFps reads the newest whole row and ignores the rest')
def t_mango_fps():
    import time
    d = tempfile.mkdtemp()
    cfg = oledd.load_config('/nonexistent')
    cfg['game']['mangohud_logs'] = d
    m = oledd.MangoHudFps(cfg)
    now = time.time()
    eq(m.read(now), None, 'empty folder')

    log = os.path.join(d, 'Game.exe_2026-10-02_15-00-00.csv')
    with open(log, 'w') as f:
        f.write(_MANGO_HEAD)
    m._scanned = 0
    eq(m.read(time.time()), None, 'header only, no samples yet')

    with open(log, 'a') as f:
        f.write(_mango_row(143.6) + _mango_row(87.2) + '61.0,16.')  # half-written
    m._scanned = 0
    eq(m.read(time.time()), 87.2, 'last whole row, not the partial one')

    # The end-of-run summary sits beside the log and must not be mistaken for it.
    summary = log.replace('.csv', '_summary.csv')
    with open(summary, 'w') as f:
        f.write('0.1% Min FPS,1% Min FPS,97% Percentile FPS,Average FPS\n1,2,3,4\n')
    m._scanned = 0
    eq(m.read(time.time()), 87.2, 'summary file ignored')

    old = time.time() - 10
    os.utime(log, (old, old))
    m._scanned = 0
    eq(m.read(time.time()), None, 'log stopped growing = game closed')

    ancient = time.time() - 3 * 86400
    os.utime(log, (ancient, ancient))
    m._scanned = 0
    m.read(time.time())
    eq(os.path.exists(log), False, 'old session logs pruned')


@check('GameSource claims the screen on a live MangoHud log, without gamemode')
def t_game_fps_source():
    import time

    class _S:
        def gamemode(self): return False
        def gpu(self): return {'util': 100, 'temp': 87}
        def cpu_util(self): return 13.0
        def cpu_temp(self): return 104
        def swap_rate(self): return (0.0, 0.0)
        def mem(self): return (9.0, 31.0)

    d = tempfile.mkdtemp()
    ctx = _Ctx()
    ctx.s = _S()
    ctx.cfg['game']['mangohud_logs'] = d
    src = oledd.GameSource(ctx)
    eq(src.active(time.time()), False, 'no game, no gamemode')

    log = os.path.join(d, 'Game.exe_2026-10-02_15-00-00.csv')
    for fps in (7, 144, 1240, 9999):
        with open(log, 'w') as f:
            f.write(_MANGO_HEAD + _mango_row(fps))
        src._mango._scanned = 0
        now = time.time()
        eq(src.active(now), True, f'{fps} fps: active')
        img = src.render(now)
        eq(img.size, (W, H), f'{fps} fps: frame size')
        # The number must stay inside its column and clear of the burn-in
        # margin, however many digits it has.
        box = img.crop((0, 0, src.FPS_COL, H)).getbbox()
        if box and (box[0] < 1 or box[2] > src.FPS_COL):
            raise AssertionError(f'{fps} fps: digits spill out of the column {box}')


def main():
