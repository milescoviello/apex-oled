@check('FontChain falls back per character and keeps the primary metrics')
def t_fontchain():
    font = oledd.Fonts(oledd.load_config('/nonexistent')).get(12)
    if not isinstance(font, apex.FontChain):
        return                          # no freetype: nothing to fall back in
    eq(font.getmetrics(), font.primary.getmetrics(), 'metrics')
    latin = apex.visual_runs('Distortion', font.faces)
    eq(len(latin), 1, 'Latin is one run')
    eq(latin[0][1] is font.faces.primary, True, 'Latin stays on the primary')
    jp = apex.visual_runs('結束バンド', font.faces)
    if jp[0][1] is font.faces.primary:
        return                          # no CJK font installed on this machine
    eq(len(jp), 1, 'Japanese is one run')
    # Drawing must ink something real, not the primary's empty-box glyph.
    a, b = Image.new('1', (40, 20), 0), Image.new('1', (40, 20), 0)
    font.draw(ImageDraw.Draw(a), (0, 0), '結', 1)
    ImageDraw.Draw(b).text((0, 0), '結', font=font.primary, fill=1)
    if a.tobytes() == b.tobytes():
        raise AssertionError('CJK drew the same as the primary font (a box)')


@check('right-to-left runs come out in display order')
def t_bidi():
    font = oledd.Fonts(oledd.load_config('/nonexistent')).get(12)
