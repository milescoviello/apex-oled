def _fake_input(root, node, name, key='0', rel='0', abs_='0', props='0'):
    """A /sys/class/input/eventN directory with just what the daemon reads.

    Bitmaps are given exactly as the kernel prints them; the defaults in the
    checks below were copied from real devices.
    """
    dev = os.path.join(root, node, 'device')
    os.makedirs(os.path.join(dev, 'capabilities'))
    for rel_path, text in (('name', name), ('properties', props),
                           ('capabilities/key', key), ('capabilities/rel', rel),
                           ('capabilities/abs', abs_)):
        with open(os.path.join(dev, rel_path), 'w') as f:
            f.write(text + '\n')
    return os.path.join(root, node)


@check('evdev_caps() reads unpadded sysfs bitmaps as one bit per code')
def t_evdev_caps():
