        good = f.name
    cfg = oledd.load_config(good)
    eq(cfg['fonts']['ui_size'], 99, 'override applied')
    eq(cfg['fonts']['family'], 'condensed', 'unspecified keys keep defaults')


@check('compose() keeps the burn-in shift inside the panel')
def t_compose_bounds():
    cfg = oledd.load_config('/nonexistent')
    src = Image.new('1', (W, H), 1)
    for t in range(0, 1200, 7):
        out = oledd.compose(src, float(t), cfg)
        eq(out.size, (W, H), 'composed size')


def main():
    verbose = '-v' in sys.argv
    for name, fn in RUN:
        try:
            fn()
            if verbose:
                print(f'  ok    {name}')
        except Exception as e:
            FAILS.append((name, e))
            print(f'  FAIL  {name}\n          {e}')
    print(f'\n{len(RUN) - len(FAILS)}/{len(RUN)} checks passed')
    return 1 if FAILS else 0


if __name__ == '__main__':
    sys.exit(main())
