@check('Presence scan opens wanted nodes once, and retries ones it could not open')
def t_presence_scan():
    import threading
    sysfs, dev = _fake_inputs()
    ctx = _Ctx()
    ctx.stop = threading.Event()
    p = oledd.Presence(ctx, 5, oledd.DEFAULTS['display']['afk_ignore'])
    p.SYSFS, p.DEV = sysfs, dev
    try:
        p.scan()
        eq(p.fds, {}, 'no device nodes yet (unreadable)')
        p.last_input -= 3600
        eq(p.away(), False, 'nothing watched is never away')
        # Regular files stand in for the /dev nodes; the hotplug case is a
        # node that failed to open (udev had not set its group yet) and must
        # be picked up on the next pass, not skipped forever.
        for node, *_ in _DEVICES:
            open(os.path.join(dev, node), 'w').close()
        p.scan()
        want = sorted(os.path.join(dev, n) for n, *_, w in _DEVICES if w)
        eq(sorted(p.fds), want, 'watched nodes')
        eq(p.away(), False, 'first devices restart the clock')
        fds = dict(p.fds)
        p.scan()
        eq(p.fds, fds, 'a rescan does not reopen')
    finally:
        p.close()


