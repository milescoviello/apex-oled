class _FakeBackend:
    def __init__(self, name, view, idle_poll=5.0):
        self.name, self.idle_poll, self._v, self.polled = name, idle_poll, view, 0

    def poll(self):
        self.polled += 1
        return self._v


@check('QwenSource picks the server that is up, and alarms for a stranded client')
def t_qwen_backend_choice():
    real = oledd.process_running
    up = lambda name: oledd.qwen_view(backend=name, up=True, state='idle')
    off = lambda name, broken=False: oledd.qwen_view(backend=name, broken=broken)

    def run(strata, llama, backend='auto', client=False):
        src = oledd.QwenSource(_qwen_ctx())
        src.ctx.cfg['qwen']['backend'] = backend
        fakes = [_FakeBackend('strata', strata), _FakeBackend('llama', llama)]
        src._backends = {b.name: b for b in fakes}
        oledd.process_running = lambda names: client
        src._poll_once()
        return src._view, fakes

    try:
        v, (s, l) = run(up('strata'), up('llama'))
        eq((v['backend'], l.polled), ('strata', 0), 'Strata first; llama not polled')
        v, _ = run(off('strata'), up('llama'))
        eq(v['backend'], 'llama', 'falls back to llama.cpp')
        v, _ = run(off('strata'), off('llama'))
        eq((v['up'], v['broken']), (False, False), 'both off: stack off, quiet')
        v, _ = run(off('strata'), None)
        eq((v['up'], v['broken']), (False, False), 'qwen-status missing: still off')
        v, _ = run(off('strata'), off('llama'), client=True)
        eq(v['broken'], True, 'omp running with nothing to talk to')
        v, _ = run(off('strata'), off('llama', broken=True))
        eq(v['broken'], True, 'llama proxy up, model down')
        v, _ = run(up('strata'), up('llama'), client=True)
        eq(v['broken'], False, 'a client with a server up is fine')
        v, (s, l) = run(up('strata'), up('llama'), backend='llama')
        eq((v['backend'], s.polled), ('llama', 0), 'backend pinned to llama')
        v, _ = run(None, None)
        eq(v, None, 'nobody could tell')
    finally:
        oledd.process_running = real


