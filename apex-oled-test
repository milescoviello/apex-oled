# Shapes recorded from a live Strata 0.1.39 (flashnext-serve) during omp turns.
_STRATA_HEALTH = {'status': 'ok', 'max_context': 131072, 'loaded': True,
                  'model': 'flashnext-abliterated-iq2_xs', 'service': 'strata'}
_STRATA_LAST = {'prompt_tokens': 22958, 'reused': 22927, 'output_tokens': 34,
                'prompt_total': 22958, 'prompt_read': 31, 'decode_tok_s': 67.4,
                'finish': 'stop'}
_STRATA_HW = {'gpu_util': 96, 'gpu_temp': 74, 'gpu_power': 135.6,
