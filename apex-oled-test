    # A touchpad: BTN_LEFT (272) in the fifth word, BTN_TOOL_FINGER (325) and
    # BTN_TOUCH (330) in the sixth, every lower word printed as a bare "0".
    pad = _fake_input(root, 'event5', 'Touchpad', key='e520 10000 0 0 0 0')
    keys = oledd.evdev_caps(pad, 'capabilities/key')
    for code in (272, 325, 330):
        eq(keys >> code & 1, 1, f'code {code} set')
    for code in (0, 30, 271, 273, 324):
        eq(keys >> code & 1, 0, f'code {code} clear')
    eq(oledd.evdev_caps(pad, 'capabilities/rel'), 0, 'empty bitmap')
    eq(oledd.evdev_caps(pad, 'no/such/file'), 0, 'missing file reads as empty')


