        return
    runs = apex.visual_runs('abc אב', font.faces)
    texts = [t for t, _, _ in runs]
    want = ['abc ', 'אב'] if apex.RAQM else ['abc ', 'בא']
    eq(texts, want, 'LTR paragraph with a Hebrew word')
