@check('QwenSource treats a failing qwen-status as "no idea", not a crash')
def t_qwen_command_failure():
    import time
    ctx = _qwen_ctx()
    ctx.cfg['qwen']['command'] = '/nonexistent/qwen-status-missing'
    src = oledd.QwenSource(ctx)
