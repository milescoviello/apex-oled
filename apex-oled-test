#!/usr/bin/env python3
"""apex-oled-test - self-contained checks for the OLED tooling.

No pytest dependency and no keyboard required: everything here is pure
rendering/packing logic. Run it after touching apex-oled or apex-oledd.

    apex-oled-test          # run all, print a summary
    apex-oled-test -v       # list every check
"""
import os
import random
import sys
import tempfile
import threading
from importlib.machinery import SourceFileLoader

from PIL import Image, ImageDraw

_HERE = os.path.dirname(os.path.realpath(__file__))
apex = SourceFileLoader('apex_oled', os.path.join(_HERE, 'apex-oled')).load_module()
oledd = SourceFileLoader('apex_oledd', os.path.join(_HERE, 'apex-oledd')).load_module()

W, H = apex.WIDTH, apex.HEIGHT
FAILS, RUN = [], []


def check(name):
    def deco(fn):
        RUN.append((name, fn))
        return fn
    return deco


def eq(got, want, what=''):
    if got != want:
        raise AssertionError(f'{what}: got {got!r}, want {want!r}')


# --- packing ---------------------------------------------------------------

def _patterns():
    random.seed(7)
    imgs = []
    noise = Image.new('1', (W, H), 0)
    px = noise.load()
    for y in range(H):
        for x in range(W):
            px[x, y] = random.randint(0, 1)
    imgs.append(('noise', noise))

    corners = Image.new('1', (W, H), 0)
    p = corners.load()
    for xy in ((0, 0), (W - 1, 0), (0, H - 1), (W - 1, H - 1)):
        p[xy] = 1
    imgs.append(('corners', corners))

    for name, fn in (('rows', lambda x, y: y % 2),
                     ('cols', lambda x, y: x % 2),
                     ('diag', lambda x, y: (x + y) % 2),
                     ('pageedge', lambda x, y: 1 if y % 8 in (0, 7) else 0)):
        im = Image.new('1', (W, H), 0)
        q = im.load()
        for y in range(H):
            for x in range(W):
                q[x, y] = fn(x, y)
        imgs.append((name, im))

    blank = Image.new('1', (W, H), 0)
    full = Image.new('1', (W, H), 1)
    imgs += [('blank', blank), ('full', full)]

    text = Image.new('1', (W, H), 0)
    ImageDraw.Draw(text).text((2, 2), 'Testing 123', fill=1)
    imgs.append(('text', text))
    return imgs


@check('pack() matches the reference implementation')
def t_pack_matches_reference():
    for name, img in _patterns():
        a, b = apex.pack(img), apex.pack_reference(img)
        eq(len(a), 640, f'{name} length')
        if a != b:
            i = next(i for i, (p, q) in enumerate(zip(a, b)) if p != q)
            raise AssertionError(f'{name}: first differing byte at {i}')


@check('unpack() round-trips pack()')
def t_unpack_roundtrip():
    for name, img in _patterns():
        back = apex.unpack(apex.pack(img))
        # Compare packed bits, not pixel ints: mode '1' stores an assigned 1
        # as 1 but a decoded set pixel as 255, so getdata() would differ on
        # images that are actually identical.
        if back.tobytes() != img.tobytes():
            raise AssertionError(f'{name}: round trip changed pixels')


@check('pack() rejects wrong-sized framebuffers')
def t_unpack_validates():
    for bad in (b'', b'\x00' * 639, b'\x00' * 641):
        try:
            apex.unpack(bad)
        except ValueError:
            continue
        raise AssertionError(f'accepted {len(bad)}-byte framebuffer')


@check('pack() resizes and dithers non-native input')
def t_pack_resizes():
    eq(len(apex.pack(Image.new('RGB', (640, 200), (128, 128, 128)))), 640,
       'resized RGB input')


# --- text layout -----------------------------------------------------------

@check('wrap() balances rather than packing greedily')
def t_wrap_balanced():
    font = oledd.Fonts(oledd.DEFAULTS).get(12)
    rows = oledd.wrap('Blow by blow and go away', 124, font, lines=2)
    if rows is None:
        raise AssertionError('failed to wrap a line that fits')
    eq(len(rows), 2, 'row count')
    wa, wb = (oledd.text_width(r, font) for r in rows)
    # greedy would leave a stray last word; balanced keeps the halves close
    if abs(wa - wb) > max(wa, wb) * 0.5:
        raise AssertionError(f'rows badly unbalanced: {rows}')


@check('wrap() returns None when it cannot fit')
def t_wrap_gives_up():
    font = oledd.Fonts(oledd.DEFAULTS).get(12)
    long = 'supercalifragilisticexpialidocious ' * 6
    eq(oledd.wrap(long, 124, font, lines=2), None, 'unfittable text')


@check('wrap() keeps every word, in order')
def t_wrap_lossless():
    font = oledd.Fonts(oledd.DEFAULTS).get(12)
    for s in ('Yeah, you do not know my mind, you do not know my kind',
              'in its right place', 'Playing the hand'):
        for lines in (2, 3):
            rows = oledd.wrap(s, 124, font, lines=lines)
            if rows and ' '.join(rows).split() != s.split():
                raise AssertionError(f'words changed: {rows}')


@check('fit() truncates to the available width')
def t_fit():
    font = oledd.Fonts(oledd.DEFAULTS).get(12)
    out = oledd.fit('Red Hot Chili Peppers - Dark Necessities', 80, font)
    if oledd.text_width(out, font) > 80:
        raise AssertionError(f'{out!r} still too wide')
    if not out.endswith('..'):
        raise AssertionError(f'{out!r} not marked as truncated')
    eq(oledd.fit('short', 124, font), 'short', 'text that already fits')


