@check('Presence thread notices input on a watched fd')
def t_presence_thread():
    import threading
    import time
    ctx = _Ctx()
    ctx.stop = threading.Event()
    p = oledd.Presence(ctx, 1 / 60)         # one second
    p.SYSFS = tempfile.mkdtemp()            # nothing real to find
    r, w = os.pipe()
    p.fds['/dev/input/event99'] = r
    p.last_input -= 10
    eq(p.away(), True, 'away before any input')
    p.start()
    try:
        os.write(w, _ev(2, 0, 5) + SYN)
        deadline = time.monotonic() + 3
        while p.away() and time.monotonic() < deadline:
            time.sleep(0.01)
        eq(p.away(), False, 'back after mouse motion')
        eq(ctx.wake.is_set(), True, 'main loop woken')
        if p.idle_for() > 1:
            raise AssertionError(f'idle_for {p.idle_for():.1f}s after input')
    finally:
        ctx.stop.set()
        p.join(3)
        os.close(w)
    eq(p.is_alive(), False, 'thread stops with the daemon')


@check('should_blank: lock and manual are absolute, absence yields to notify')
def t_should_blank():
    import time

    class _Sess:
        def __init__(self, **kw): self.d = kw
        def session(self): return self.d

    class _Away:
        def __init__(self, away): self._away = away
        def away(self): return self._away

    def why(locked=False, idle=False, away=None, notify=False, manual=False,
            on_idle=False):
        ctx = _Ctx()
        ctx.cfg['display']['blank_on_idle'] = on_idle
        ctx.s = _Sess(locked=locked, idle=idle)
        ctx.blank_override = manual
        ctx.presence = None if away is None else _Away(away)
        ctx.notify = oledd.NotifySource(ctx)
        if notify:
            ctx.notify.push(Image.new('1', (W, H), 0), 5)
        return oledd.Context.should_blank(ctx, time.time())

    eq(why(), None, 'nothing to blank for')
    eq(why(away=False), None, 'someone is here')
    eq(why(away=True), 'away', 'nobody is here')
    eq(why(away=True, notify=True), None, 'a pushed frame still shows')
    eq(why(locked=True, away=True, notify=True), 'locked', 'lock beats notify')
    eq(why(manual=True, notify=True), 'manual', 'manual beats notify')
    eq(why(idle=True), None, 'IdleHint ignored unless blank_on_idle')
    eq(why(idle=True, on_idle=True), 'idle', 'IdleHint with blank_on_idle')
    eq(why(idle=True, on_idle=True, notify=True), None, 'idle yields to notify')


