@check('otsu_threshold() adapts to dark and bright images')
def t_otsu():
    # bimodal: half the pixels at 40, half at 200 -> cutoff between them
    hist = [0] * 256
    hist[40] = 500
    hist[200] = 500
    cut = oledd.otsu_threshold(hist)
    if not 40 <= cut < 200:
        raise AssertionError(f'bimodal cutoff {cut} not between the modes')
    # a dark cover: everything under 60. A fixed 128 renders this black;
    # otsu must land inside the actual range so detail survives.
    hist = [0] * 256
    for v in range(10, 60):
        hist[v] = 20
    cut = oledd.otsu_threshold(hist)
    if not 10 <= cut < 60:
        raise AssertionError(f'dark-image cutoff {cut} outside the data')
    # a bright cover: everything over 200
    hist = [0] * 256
    for v in range(200, 250):
        hist[v] = 20
    cut = oledd.otsu_threshold(hist)
    if not 200 <= cut < 250:
        raise AssertionError(f'bright-image cutoff {cut} outside the data')
    eq(oledd.otsu_threshold([0] * 256), 128, 'empty histogram falls back')


@check('tile_score() ranks a blank tile worse than a structured one')
def t_tile_score():
    blank = Image.new('1', (34, 34), 0)
    white = Image.new('1', (34, 34), 1)
    half = Image.new('1', (34, 34), 0)
    ImageDraw.Draw(half).rectangle([0, 0, 33, 16], fill=1)      # clean shapes
    noise = Image.new('1', (34, 34), 0)
    px = noise.load()
    random.seed(3)
    for y in range(34):
        for x in range(34):
            px[x, y] = random.randint(0, 1)
    s_blank, s_white = oledd.tile_score(blank), oledd.tile_score(white)
    s_half, s_noise = oledd.tile_score(half), oledd.tile_score(noise)
    if not s_half < s_blank:
        raise AssertionError(f'blank ({s_blank:.3f}) scored better than shapes ({s_half:.3f})')
    if not s_half < s_white:
        raise AssertionError(f'all-white ({s_white:.3f}) scored better than shapes')
    if not s_half < s_noise:
        raise AssertionError(f'noise ({s_noise:.3f}) scored better than shapes')


@check('in_gap() finds intros, breaks, outros - not normal line spacing')
def t_in_gap():
    G = oledd.LyricsSource.in_gap
    lyrics = [[10.0, 'first line'], [14.0, 'second line'], [40.0, 'after a break']]
    cases = [
        (0.0,  True,  'before the first line'),
        (11.0, False, 'just after a line started'),
        (14.5, False, 'normal 4s line spacing'),
        (25.0, True,  'middle of a 26s instrumental break'),
        (39.0, False, 'next line is imminent'),
        (41.0, False, 'just after the last line'),
        (60.0, True,  'outro, well past the last line'),
    ]
    for pos, want, why in cases:
        got = G(lyrics, pos, 8.0)
        if got != want:
            raise AssertionError(f'pos={pos} ({why}): got {got}, want {want}')
    # an explicit blank in the .lrc is always a gap
    eq(G([[0.0, ''], [30.0, 'x']], 1.0, 8.0), True, 'blank lyric line')


@check('LyricsSource holds the card briefly after a pause, then yields')
def t_pause_hold():
    import json
    import os
    import time
    ctx = _Ctx()
    now = time.time()
    st = {'artist': 'A', 'title': 'T', 'playing': False, 'anchor_wall': now,
          'anchor_pos': 5.0, 'duration': 100.0, 'lyrics_synced': False,
          'written_at': now, 'lyrics': []}
    with tempfile.NamedTemporaryFile('w', suffix='.json', delete=False) as f:
        json.dump(st, f)
        path = f.name
    try:
        src = oledd.LyricsSource(ctx, path)
        hold = ctx.cfg['lyrics']['pause_hold']
        eq(src.active(now), True, 'just paused')
        eq(src.active(now + hold / 2), True, 'inside the hold window')
        eq(src.active(now + hold + 1), False, 'after the hold window')
    finally:
        os.unlink(path)


@check('resuming playback clears the pause timer')
def t_pause_reset():
    import json
    import os
    import time
    ctx = _Ctx()
    now = time.time()
    paused = {'artist': 'A', 'title': 'T', 'playing': False, 'anchor_wall': now,
              'anchor_pos': 5.0, 'duration': 100.0, 'lyrics_synced': False,
              'written_at': now, 'lyrics': []}
    with tempfile.NamedTemporaryFile('w', suffix='.json', delete=False) as f:
        json.dump(paused, f)
        path = f.name
    try:
        src = oledd.LyricsSource(ctx, path)
        src.active(now)
        # resume: rewrite the file as playing and force a reload
        with open(path, 'w') as f:
            json.dump({**paused, 'playing': True, 'written_at': now + 100}, f)
        os.utime(path, (now + 100, now + 100))
        src._checked = 0
        eq(src.active(now + 100), True, 'playing again')
        # pause once more; the window must restart, not count from the first pause
        with open(path, 'w') as f:
            json.dump({**paused, 'written_at': now + 200}, f)
        os.utime(path, (now + 200, now + 200))
        src._checked = 0
        eq(src.active(now + 200), True, 'newly paused holds again')
    finally:
        os.unlink(path)


def _qwen(status, gen_seen=0.0):
    """A QwenSource with its poller disabled and a status injected."""
    import threading
    ctx = _Ctx()
    ctx.stop = threading.Event()
    ctx.stop.set()                      # the poll thread exits immediately
    src = oledd.QwenSource(ctx)
    src._status = status
    src._gen_seen = gen_seen
    return src


@check('QwenSource yields when the stack is idle, claims the screen when busy')
def t_qwen_gating():
    import time
    now = time.time()
    base = {'model_up': True, 'proxy_up': True, 'ctx_size': 229376,
            'gen_tok_s': 99.9, 'gpu': {}, 'ts': now,
            'prefill': {'tokens_done': 10, 'fraction': 1.0, 'complete': True}}
    cases = [
        ('idle, generation long ago', {**base}, 0.0, False),
        ('prefill in progress',
         {**base, 'prefill': {**base['prefill'], 'complete': False}}, 0.0, True),
        ('model down', {**base, 'model_up': False}, 0.0, True),
        ('generation just finished', {**base}, now, True),
        ('no prefill yet', {**base, 'prefill': None}, 0.0, False),
        ('status unavailable', None, 0.0, False),
    ]
    for name, st, seen, want in cases:
        got = _qwen(st, seen).active(now)
        if got != want:
            raise AssertionError(f'{name}: active={got}, want {want}')


@check('QwenSource fires on a prefill completing, not on a wobbling rate')
def t_qwen_completion_trigger():
    import time
    now = time.time()
    src = _qwen(None)
    busy = {'model_up': True, 'ctx_size': 1, 'gpu': {}, 'gen_tok_s': 24.9,
            'prefill': {'complete': False, 'fraction': 0.5}}
    done = {**busy, 'prefill': {'complete': True, 'fraction': 1.0}}

    # a rolling gen_tok_s that merely wobbles must not look like fresh output;
    # this ping-ponged with the lyrics view every 10s in practice
    src._status, src._prev_complete = done, True
    for rate in (24.9, 24.3, 99.9, 24.3):
        src._status = {**done, 'gen_tok_s': rate}
        pf = src._status['prefill']
        complete = bool(pf.get('complete'))
        if complete and src._prev_complete is False:
            src._gen_seen = time.time()
        src._prev_complete = complete
    eq(src.active(now), False, 'wobbling gen_tok_s must not activate')

    # a real False -> True completion is news
    src._prev_complete = False
    pf = done['prefill']
    if pf['complete'] and src._prev_complete is False:
        src._gen_seen = time.time()
    src._prev_complete = True
    src._status = done
    eq(src.active(time.time()), True, 'prefill completing activates')


@check('live decode rate comes from n_decoded deltas, not the stale average')
def t_qwen_live_rate():
    import io
    import json as _json
    import threading
    import urllib.request

    ctx = _Ctx()
    ctx.stop = threading.Event()
    ctx.stop.set()
    ctx.cfg['qwen']['slots_url'] = 'http://stub/slots'
    src = oledd.QwenSource(ctx)

    clock = [1000.0]
    real_time, real_open = oledd.time.time, urllib.request.urlopen
    slot = {'n_prompt_tokens': 210000, 'n_ctx': 229376, 'is_processing': True,
            'next_token': [{'n_decoded': 0}]}

    class Resp(io.BytesIO):
        def __enter__(self): return self
        def __exit__(self, *a): return False

    def fake_open(*a, **k):
        return Resp(_json.dumps([slot]).encode())

    oledd.time.time = lambda: clock[0]
    urllib.request.urlopen = fake_open
    try:
        # 20 tokens per second, sampled once a second
        for i in range(5):
            slot['next_token'][0]['n_decoded'] = i * 20
            clock[0] = 1000.0 + i
            src._poll_slots()
        if not (18 <= src._live_tps <= 22):
            raise AssertionError(f'expected ~20 tok/s, got {src._live_tps}')
        eq(src._ctx_used, (210000, 229376), 'context occupancy')

        # a new turn restarts the count; the stale rate must be dropped
        slot['next_token'][0]['n_decoded'] = 3
        clock[0] += 1
        src._poll_slots()
        eq(src._live_tps, None, 'rate cleared when n_decoded goes backwards')

        # once the turn ends there is no live rate at all
        slot['is_processing'] = False
        clock[0] += 1
        src._poll_slots()
        eq(src._live_tps, None, 'no live rate while idle')
    finally:
        oledd.time.time = real_time
        urllib.request.urlopen = real_open


