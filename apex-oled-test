@check('draw_bar() handles 0, tiny, half and full without crashing')
def t_bar_edges():
    for frac in (None, 0.0, 0.001, 0.01, 0.5, 0.999, 1.0, -5.0, 5.0):
        img = Image.new('1', (W, H), 0)
        oledd.draw_bar(img, (3, 2, 60, 8), frac)   # regression: 1% crashed here


@check('draw_bar() fill scales with the fraction')
def t_bar_monotonic():
    def lit(frac):
        img = Image.new('1', (W, H), 0)
        oledd.draw_bar(img, (3, 2, 60, 8), frac)
        px = img.load()
        return sum(1 for x in range(W) for y in range(H) if px[x, y])
    a, b, c = lit(0.0), lit(0.5), lit(1.0)
    if not a < b < c:
        raise AssertionError(f'not monotonic: 0%={a} 50%={b} 100%={c}')


# --- sources ---------------------------------------------------------------

class _Ctx:
    def __init__(self):
        self.cfg = oledd.load_config('/nonexistent')
        self.fonts = oledd.Fonts(self.cfg)
        self.s = None


@check('LyricsSource renders every layout branch to a valid frame')
def t_lyrics_layouts():
    import json
    import os
    import time
    ctx = _Ctx()
    now = time.time()
    cases = [
        ('short', 'Playing the hand', True),
        ('two rows', 'Blow by blow and go away', True),
        ('three rows', "Yeah, you do not know my mind, you do not know my kind", True),
        ('unsynced', '', False),
    ]
    for name, lyric, synced in cases:
        with tempfile.NamedTemporaryFile('w', suffix='.json', delete=False) as f:
            json.dump({'artist': 'Radiohead', 'title': 'Everything In Its Right Place',
                       'playing': True, 'anchor_wall': now, 'anchor_pos': 42.0,
                       'duration': 251.0, 'lyrics_synced': synced,
                       'written_at': now,
                       'lyrics': [[0.0, lyric]] if synced else []}, f)
            path = f.name
        try:
            src = oledd.LyricsSource(ctx, path)
            if not src.active(now):
                raise AssertionError(f'{name}: source inactive')
            img = src.render(now)
            eq(img.size, (W, H), f'{name} frame size')
            eq(img.mode, '1', f'{name} frame mode')
        finally:
            os.unlink(path)


@check('LyricsSource goes inactive on stale or stopped state')
def t_lyrics_inactive():
