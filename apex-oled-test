def _strata_metrics(**live):
    base = {'state': 'idle', 'queued': 0, 'phase': None, 'prompt_tokens': None,
            'prompt_read': None, 'prompt_total': None, 'generated': None,
            'elapsed_s': None, 'tok_s': None, 'prefill_tok_s_mean': None}
    return {'engine': {'max_context': 131072}, 'live': {**base, **live},
            'requests': [_STRATA_LAST], 'hardware': _STRATA_HW}


@check('StrataBackend maps /health + /metrics onto the shared view')
def t_strata_views():
    be = oledd.StrataBackend(_qwen_ctx())
    now = 1000.0

    # before the first chunk lands, only the prompt length is known
    v = be.view(_STRATA_HEALTH, _strata_metrics(
        state='reading', phase='reading the prompt', prompt_tokens=7927,
        generated=0, elapsed_s=5.0), now)
    eq((v['up'], v['state']), (True, 'reading'), 'early prefill state')
    eq((v['prefill']['frac'], v['prefill']['total'], v['prefill']['rate'],
        v['prefill']['eta'], v['prefill']['elapsed']), (0.0, 7927, None, None, 5.0),
       'early prefill numbers')

    v = be.view(_STRATA_HEALTH, _strata_metrics(
        state='reading', prompt_tokens=7927, prompt_read=3000,
        prompt_total=7927, prefill_tok_s_mean=1000.0), now)
    pf = v['prefill']
    eq((pf['done'], pf['total'], pf['rate']), (3000, 7927, 1000.0), 'mid prefill')
    if abs(pf['frac'] - 3000 / 7927) > 1e-9 or abs(pf['eta'] - 4.927) > 1e-9:
