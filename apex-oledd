def evdev_caps(sysdir, what):
    """An evdev node's sysfs bitmap as one int, so bit n is code n.

    `what` is 'capabilities/key', 'capabilities/rel', 'properties' and so on.
    The kernel writes 64-bit hex words, most significant first, without zero
    padding ("30000 0 0 0 0"), so each word is padded back out before joining.
    """
    try:
        with open(os.path.join(sysdir, 'device', what)) as f:
            words = f.read().split()
    except OSError:
        return 0
    try:
        return int(''.join(w.zfill(16) for w in words) or '0', 16)
    except ValueError:
        return 0


class Hotkeys(threading.Thread):
    """Watch the keyboard for <modifier>+<key> and drive the panel with it.

    Right Meta rather than the SteelSeries key: the SteelSeries key is handled
    entirely in the keyboard's firmware and never reaches the host, so nothing
    on this side can bind it. Right Meta is a real key, distinct from left Meta
    at the evdev level (126 vs 125) - a distinction KDE's own shortcut config
    cannot express - and is otherwise unused.

    This only observes. Suppressing the keypress would need EVIOCGRAB, which
    grabs the whole keyboard and would swallow all typing, so bind combinations
    that applications ignore.
    """
    MODIFIERS = {'rightmeta': 126, 'leftmeta': 125, 'rightalt': 100,
                 'rightctrl': 97, 'rightshift': 54}
    KEYS = {
        **{str(n): 2 + i for i, n in enumerate([1, 2, 3, 4, 5, 6, 7, 8, 9, 0])},
        **{c: k for c, k in zip('qwertyuiop', range(16, 26))},
        **{c: k for c, k in zip('asdfghjkl', range(30, 39))},
        **{c: k for c, k in zip('zxcvbnm', range(44, 51))},
        **{f'f{i}': 58 + i for i in range(1, 11)}, 'f11': 87, 'f12': 88,
        'space': 57, 'enter': 28, 'tab': 15, 'esc': 1,
        'up': 103, 'down': 108, 'left': 105, 'right': 106,
    }
    EV_KEY = 1
    EVENT_SIZE = 24         # struct input_event on 64-bit: 16b timeval + H H i

    def __init__(self, ctx, on_action):
        super().__init__(daemon=True)
        self.ctx = ctx
        self.on_action = on_action
        cfg = ctx.cfg['hotkeys']
        self.mod = self.MODIFIERS.get(str(cfg.get('modifier', 'rightmeta')).lower())
        self.bindings = {}
        for key, action in (cfg.get('bindings') or {}).items():
            code = self.KEYS.get(str(key).lower())
            if code is not None:
                self.bindings[code] = action

    @staticmethod
    def find_keyboard(want_code=30):
        """The evdev node carrying ordinary keys for the Apex.

        The device also exposes Consumer Control and Mouse nodes; the plain
        keyboard one is the only one that reports KEY_A, so check the sysfs
        capability bitmap for it rather than guessing at the node order.
        """
        best = None
        for sysdir in sorted(glob.glob('/sys/class/input/event*')):
            try:
                if 'Apex Pro Gen 3' not in open(sysdir + '/device/name').read():
                    continue
            except OSError:
                continue
            node = '/dev/input/' + os.path.basename(sysdir)
            best = best or node
            if evdev_caps(sysdir, 'capabilities/key') >> want_code & 1:
                return node
        return best

    def run(self):
        if not self.mod or not self.bindings:
            return
        held = False
        fd = None
        while not self.ctx.stop.is_set():
            if fd is None:
                node = self.find_keyboard()
                if node is None:
                    if self.ctx.stop.wait(5.0):
                        break
                    continue
                try:
                    fd = os.open(node, os.O_RDONLY | os.O_NONBLOCK)
                except OSError:
                    fd = None
                    if self.ctx.stop.wait(5.0):
                        break
                    continue
            try:
                r, _, _ = select.select([fd], [], [], 0.5)
                if not r:
                    continue
                data = os.read(fd, 4096)
            except OSError:
                os.close(fd)
                fd = None                   # unplugged; rediscover the node
                continue
            for i in range(0, len(data) - self.EVENT_SIZE + 1, self.EVENT_SIZE):
                _, _, etype, code, value = struct.unpack('qqHHi',
                                                         data[i:i + self.EVENT_SIZE])
                if etype != self.EV_KEY:
                    continue
                if code == self.mod:
                    held = value != 0
                elif held and value == 1 and code in self.bindings:
                    try:
                        self.on_action(self.bindings[code])
                    except Exception:       # a bad binding must not kill the thread
                        pass
        if fd is not None:
            os.close(fd)


class Presence(threading.Thread):
    """Whether anyone is at the machine, judged from raw input.

    The panel should go dark when nobody is looking, and the desktop cannot
    say when that is here: KDE never sets logind's IdleHint, and
    org.freedesktop.ScreenSaver.GetSessionIdleTime answers NotSupported on
    Wayland. So read evdev directly, as the hotkeys do - but every keyboard,
    mouse, touchpad, tablet and gamepad rather than just the Apex, so mousing
    around or playing with a controller counts as being here. Needs the
    `input` group; with no readable node it never reports anyone away.

    Like the hotkeys this only observes. EVIOCGRAB would swallow the input.
    Nodes are rescanned every few seconds for hotplug, and one that fails a
    read (ENODEV once unplugged) is dropped until a rescan finds it again.
    """
    # Codes only a person-operated device reports: KEY_A, BTN_LEFT,
    # BTN_JOYSTICK, BTN_GAMEPAD, BTN_TOOL_PEN, BTN_TOUCH. Power buttons, lid
    # and jack switches, brightness keys and headphone media buttons have none.
    PERSON_CODES = (30, 272, 288, 304, 320, 330)
    # Motion sensors stream while a pad sits untouched on the desk, which
    # would make nobody ever away. Most drivers give them their own buttonless
    # node, which PERSON_CODES already skips; this catches one that doesn't.
    PROP_ACCELEROMETER = 6
    EV_KEY, EV_REL, EV_ABS = 1, 2, 3
    EVENT = struct.Struct('qqHHi')      # struct input_event on 64-bit
    SYSFS, DEV = '/sys/class/input', '/dev/input'
    RESCAN = 5.0
    # After seeing input, pause this long before looking again. A 1000 Hz
    # mouse would otherwise wake this thread a thousand times a second to
    # learn nothing new; the kernel buffers (and past its limit drops) events
    # meanwhile, and only "something happened" matters here.
    SETTLE = 0.5

    def __init__(self, ctx, minutes, ignore=(), log=lambda m: None):
        super().__init__(daemon=True)
        self.ctx = ctx
        self.timeout = minutes * 60.0
        if isinstance(ignore, str):     # a bare string would ignore by letter
            ignore = [ignore]
        self.ignore = [str(s).lower() for s in ignore if str(s)]
        self.log = log
        self.fds = {}                   # /dev/input node -> fd
        # Monotonic, so a wall-clock jump cannot blank or unblank the panel.
        self.last_input = time.monotonic()

    def idle_for(self):
        return time.monotonic() - self.last_input

    def away(self):
        """Nothing touched for the timeout. Never while nothing is watched:
        no readable device is no evidence of absence."""
        return bool(self.fds) and self.idle_for() >= self.timeout

    @classmethod
    def wanted(cls, sysdir, ignore=()):
        """The device name if a person operates this node, else None."""
        try:
            with open(os.path.join(sysdir, 'device', 'name')) as f:
                name = f.read().strip()
        except OSError:
            return None
        if any(s in name.lower() for s in ignore):
            return None
        if evdev_caps(sysdir, 'properties') >> cls.PROP_ACCELEROMETER & 1:
            return None
        keys = evdev_caps(sysdir, 'capabilities/key')
        if (any(keys >> c & 1 for c in cls.PERSON_CODES)
                or evdev_caps(sysdir, 'capabilities/rel') & 1):     # REL_X
            return name
        return None

    @classmethod
    def is_input(cls, data):
        """Whether a read holds something a person did: a key going down or
        up, or any motion. Autorepeat (value 2) is the kernel's doing - a book
        resting on the keyboard is not someone typing. SYN and MSC events
        only ever accompany the real ones."""
        whole = len(data) - len(data) % cls.EVENT.size
        for _, _, etype, _, value in cls.EVENT.iter_unpack(data[:whole]):
            if etype in (cls.EV_REL, cls.EV_ABS) or (
                    etype == cls.EV_KEY and value != 2):
                return True
        return False

    def scan(self):
        """Open every wanted node that is not already watched."""
        had = bool(self.fds)
        for sysdir in sorted(glob.glob(os.path.join(self.SYSFS, 'event*'))):
            node = os.path.join(self.DEV, os.path.basename(sysdir))
            if node in self.fds:
                continue
            name = self.wanted(sysdir, self.ignore)
            if name is None:
                continue
            try:
                self.fds[node] = os.open(node, os.O_RDONLY | os.O_NONBLOCK)
            except OSError:
                continue            # not in `input`, or unplugged mid-scan
            self.log(f'afk: watching {node} ({name})')
        if self.fds and not had:
            # Nothing to judge by until now, so start the clock here rather
            # than blanking at once on a stale timestamp.
            self.last_input = time.monotonic()

    def drain(self, ready):
        """Read every ready fd; True if any of it was a person."""
        hit = False
        for node, fd in list(self.fds.items()):
            if fd not in ready:
                continue
            try:
                data = os.read(fd, 4096)
            except BlockingIOError:
                continue
            except OSError:
                data = b''
            if not data:
                os.close(fd)
                del self.fds[node]
                self.log(f'afk: lost {node}')
                continue
            hit = self.is_input(data) or hit
        return hit

    def run(self):
        self.scan()
        if not self.fds:
            self.log('afk: no readable input device, so the panel never blanks '
                     'for absence - is this user in the `input` group?')
        rescan = time.monotonic() + self.RESCAN
        while not self.ctx.stop.is_set():
            if time.monotonic() >= rescan:
                self.scan()
                rescan = time.monotonic() + self.RESCAN
            if not self.fds:
                self.ctx.stop.wait(self.RESCAN)
                continue
            ready, _, _ = select.select(list(self.fds.values()), [], [], 1.0)
            if self.drain(ready):
                self.last_input = time.monotonic()
                self.ctx.stop.wait(self.SETTLE)
        self.close()

    def close(self):
        for fd in self.fds.values():
            try:
                os.close(fd)
            except OSError:
                pass
        self.fds.clear()


class Server(threading.Thread):
    """Unix socket accepting JSON commands, one per connection.

    Doubles as the single-instance lock: if binding fails because something is
    already listening, another daemon owns the panel.
    """

    def __init__(self, ctx, path=SOCKET_PATH):
        super().__init__(daemon=True)
        self.ctx = ctx
        self.path = path
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            self.sock.bind(path)
        except OSError:
            # Either a live daemon or a socket left behind by a crash.
            probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            try:
                probe.connect(path)
                raise RuntimeError('already running')
            except (ConnectionRefusedError, FileNotFoundError):
                os.unlink(path)
                self.sock.bind(path)
            finally:
                probe.close()
        self.sock.listen(4)
        self.sock.settimeout(0.5)

    def run(self):
        while not self.ctx.stop.is_set():
            try:
                conn, _ = self.sock.accept()
            except socket.timeout:
                continue
            except OSError:
                break
            with conn:
                try:
                    conn.settimeout(2.0)
                    data = b''
                    while b'\n' not in data and len(data) < 1 << 20:
                        chunk = conn.recv(4096)
                        if not chunk:
                            break
                        data += chunk
                    reply = self.handle(json.loads(data.decode() or '{}'))
                except (OSError, ValueError) as e:
                    reply = {'ok': False, 'error': str(e)}
                try:
                    conn.sendall((json.dumps(reply) + '\n').encode())
                except OSError:
                    pass
        try:
            self.sock.close()
            os.unlink(self.path)
        except OSError:
            pass

    def handle(self, msg):
        cmd = msg.get('cmd')
        notify = self.ctx.notify
        if cmd == 'notify':
            secs = float(msg.get('secs', 5.0))
            if msg.get('fb'):
                # Client-rendered frame: a packed 640-byte framebuffer, so any
                # client can push arbitrary pixels without us re-rendering.
                import base64
                img = apex.unpack(base64.b64decode(msg['fb']))
            elif msg.get('image'):
                img = Image.open(msg['image'])
            else:
                img = self.ctx.render_lines(msg.get('lines') or [],
                                            align=msg.get('align', 'left'),
                                            size=msg.get('size'))
            if msg.get('invert'):
                img = img.convert('L').point(lambda p: 255 - p).convert('1')
            notify.push(img, secs)
            return {'ok': True}
        if cmd == 'clear':
            notify.clear()
            return {'ok': True}
        if cmd == 'release':
            # Hand the panel to another process (an animation player wants to
            # write at full rate without the daemon redrawing over it). Time
            # limited so a crashed client cannot keep the screen forever.
            secs = float(msg.get('secs', 30.0))
            self.ctx.released_until = time.time() + max(0.0, min(secs, 1800.0))
            return {'ok': True, 'released_for': secs}
        if cmd == 'resume':
            self.ctx.released_until = 0.0
            return {'ok': True}
        if cmd == 'action':
            # Same actions the hotkey listener drives, reachable from the CLI
            # so a desktop shortcut (which *can* suppress the keypress) works.
            act = msg.get('action')
            if not act:
                return {'ok': False, 'error': 'no action given'}
            self.ctx.do_action(act)
            return {'ok': True, 'mode': self.ctx.forced_mode or 'auto',
                    'blanked': self.ctx.blank_override}
        if cmd == 'status':
            now = time.time()
            pres = self.ctx.presence
            return {'ok': True, 'source': self.ctx.current_source,
                    'sources': [s.name for s in self.ctx.sources if s.active(now)],
                    'blanked': self.ctx.blanked,
                    'blank_reason': self.ctx.blank_reason,
                    # Absence detection: seconds since the last input on any
                    # of `watching` devices, against a timeout of `afk_after`.
                    'afk': pres and {'idle_for': round(pres.idle_for(), 1),
                                     'afk_after': pres.timeout,
                                     'watching': len(pres.fds)},
                    'device_error': self.ctx.device_error,
                    'forced_mode': self.ctx.forced_mode}
        return {'ok': False, 'error': f'unknown command: {cmd!r}'}


