class Fonts:
    """Truetype when Pillow has freetype, else the bundled bitmap font.

    Without freetype every size collapses to the same 6x11 bitmap cell, so
    layouts must not assume the requested size was honoured - ask line_height().
    """

    def __init__(self, cfg):
        self.scalable = features.check('freetype2')
        name = FONT_FILES.get(cfg['fonts']['family'], FONT_FILES['condensed'])
        self.path = next(
            (os.path.join(d, name) for d in FONT_DIRS
             if os.path.exists(os.path.join(d, name))), None)
        if self.path is None:
            self.scalable = False       # fall back to the bundled bitmap font
        self.fallback = list(cfg['fonts'].get('fallback', apex.FALLBACK_FAMILIES))
        self._cache = {}

    def get(self, size):
        if size not in self._cache:
            font = None
            if self.scalable:
                try:
                    font = apex.FontChain(self.path, size, self.fallback)
                except OSError:
                    font = None
            self._cache[size] = font or ImageFont.load_default()
        return self._cache[size]


def text_width(s, font):
    return int(apex.text_length(s, font))


def line_height(font):
    try:
        ascent, descent = font.getmetrics()
        return ascent + descent
    except AttributeError:
        return 11


def draw_text(img, xy, s, font, fill=1):
    apex.draw_string(ImageDraw.Draw(img), xy, s, font, fill)


def draw_centered(img, y, s, font, x0=0, x1=WIDTH):
    draw_text(img, (x0 + (x1 - x0 - text_width(s, font)) // 2, y), s, font)


def draw_right(img, x_right, y, s, font):
    """Right-align at x_right, so numbers don't jitter as digit counts change."""
    draw_text(img, (x_right - text_width(s, font), y), s, font)


# Japanese line-breaking rules (kinsoku): these never start a line...
_NO_BREAK_BEFORE = set(
    '、。，．,.・：；？！?!)）]］｝〕〉》」』】〙〗〟’”ゝゞ々〻ー゠〜～…‥'
    'ぁぃぅぇぉっゃゅょゎゕゖァィゥェォッャュョヮヵヶㇰㇱㇲㇳㇴㇵㇶㇷㇸㇹㇺㇻㇼㇽㇾㇿ')
# ...and these never end one.
_NO_BREAK_AFTER = set('([（［｛〔〈《「『【〘〖〝‘“')


def _unspaced(ch):
    """Scripts written without spaces, so a line may break between letters:
    Chinese, Japanese and other full-width text, Thai, Lao, Myanmar, Khmer.
    Not Hangul - Korean puts spaces between words, and splitting one
    ("당 / 신의") reads as badly as splitting an English word."""
    cp = ord(ch)
    if (0xAC00 <= cp <= 0xD7AF or 0x1100 <= cp <= 0x11FF
            or 0x3130 <= cp <= 0x318F):
        return False
    return (unicodedata.east_asian_width(ch) in ('W', 'F')
            or 0x0E00 <= cp <= 0x0EFF or 0x1000 <= cp <= 0x109F
            or 0x1780 <= cp <= 0x17FF)


def break_units(s):
    """Split into the pieces a line may break between, as (text, joiner).

    Spaces separate words as before; scripts without spaces may also break
    between characters (whole clusters, so a vowel sign never strands).
    Thai and friends really break at word boundaries, which needs a
    dictionary - between clusters is the readable approximation.
    """
    units = []
    for word in s.split():
        joiner = ' ' if units else ''
        piece, prev = '', None
        for c in apex.clusters(word):
            if (prev is not None and (_unspaced(prev[0]) or _unspaced(c[0]))
                    and c[0] not in _NO_BREAK_BEFORE
                    and prev[-1] not in _NO_BREAK_AFTER):
                units.append((piece, joiner))
                piece, joiner = '', ''
            piece += c
            prev = c
        units.append((piece, joiner))
    return units


def wrap(s, avail, font, lines=2):
    """Balanced wrap into at most `lines` rows, or None if it won't fit.

    Balanced rather than greedy: greedy packs the first row full and leaves a
    stray word below ("Blow by blow and go" / "away"), which looks broken on a
    panel this small. This picks the split with the evenest rows.

    Candidate rows are scored from summed piece widths, which is fast enough
    for a Japanese line's dozens of break points; the winner is then checked
    against its real rendered width.
    """
    if text_width(s, font) <= avail:
        return [s]
    units = break_units(s)
    if len(units) < lines:
        return None
    widths = [text_width(u, font) for u, _ in units]
    space = text_width(' ', font)
    cum = [0]
    for (u, j), w in zip(units, widths):
        cum.append(cum[-1] + w + (space if j else 0))

    def est(a, b):          # width of units[a:b] as one row
        return cum[b] - cum[a] - (space if units[a][1] else 0)

    def text(a, b):
        return units[a][0] + ''.join(j + u for u, j in units[a + 1:b])

    candidates = []
    for cuts in itertools.combinations(range(1, len(units)), lines - 1):
        bounds = (0,) + cuts + (len(units),)
        ws = [est(a, b) for a, b in zip(bounds, bounds[1:])]
        if max(ws) <= avail:
            candidates.append((max(ws) - min(ws), bounds))
    for _, bounds in sorted(candidates):
        rows = [text(a, b) for a, b in zip(bounds, bounds[1:])]
        if all(text_width(r, font) <= avail for r in rows):
            return rows
    return None


def fit(s, avail, font):
    """Truncate to `avail`, marking the cut with an ellipsis."""
    if text_width(s, font) <= avail:
        return s
    cl = apex.clusters(s)               # never cut a base from its marks
    while cl and text_width(''.join(cl) + '..', font) > avail:
        cl.pop()
    return ''.join(cl).rstrip() + '..'


def row_steps(font, count=3, height=HEIGHT):
    """Top y for `count` evenly spaced rows that are guaranteed not to clip.

    Derived from the font rather than hardcoded: bumping the font size used to
    silently push the last row off the bottom of the panel.
    """
    lh = line_height(font)
    step = min(lh + 1, max(1, (height - lh) // max(1, count - 1)))
    return [i * step for i in range(count)]


_layouts = {}


def layout_text(s, avail_w, avail_h, fonts, sizes, max_lines=3):
    """Largest font and fewest rows that fit `s` into the given box.

    Returns (rows, font, line_height) or None. Trying sizes largest-first
    means short lyrics get big type and only long ones shrink.

    Memoised: the lyric view redraws 15 times a second with the same line,
    and searching break points is not free for text without spaces.
    """
    key = (s, avail_w, avail_h, tuple(sizes), max_lines, id(fonts))
    if key not in _layouts:
        if len(_layouts) > 256:
            _layouts.clear()
        _layouts[key] = _layout_text(s, avail_w, avail_h, fonts, sizes,
                                     max_lines)
    return _layouts[key]


def _layout_text(s, avail_w, avail_h, fonts, sizes, max_lines):
    for size in sizes:
        font = fonts.get(size)
        lh = line_height(font)
        for n in range(1, min(max_lines, avail_h // lh) + 1):
            rows = wrap(s, avail_w, font, lines=n)
            if rows:
                return rows, font, lh
    return None


def otsu_threshold(hist):
    """Otsu's method: the grey cutoff that best separates dark from light.

    Chosen per image from its own histogram, which is what rescues covers
    that are uniformly dark or bright - a fixed cutoff renders those blank.
    """
    total = sum(hist)
    if not total:
        return 128
    sum_all = sum(i * h for i, h in enumerate(hist))
    sum_b = w_b = 0
    best_var, best_cut = -1.0, 128
    for t, count in enumerate(hist):
        w_b += count
        if w_b == 0:
            continue
        w_f = total - w_b
        if w_f == 0:
            break
        sum_b += t * count
        mean_b = sum_b / w_b
        mean_f = (sum_all - sum_b) / w_f
        var = w_b * w_f * (mean_b - mean_f) ** 2
        if var > best_var:
            best_var, best_cut = var, t
    return best_cut


def tile_score(im):
    """Lower is better. Penalises speckle and near-blank tiles.

    Speckle is the fraction of neighbouring pixels that differ: high means
    the eye sees noise rather than shapes. The ink term punishes tiles that
    came out almost all black or all white, which score deceptively well on
    speckle alone precisely because they carry no image.
    """
    px = im.load()
    w, h = im.size
    diff = tot = lit = 0
    for y in range(h):
        for x in range(w):
            lit += 1 if px[x, y] else 0
            if x + 1 < w:
                tot += 1
                diff += px[x, y] != px[x + 1, y]
            if y + 1 < h:
                tot += 1
                diff += px[x, y] != px[x, y + 1]
    speckle = diff / tot if tot else 1.0
    ink = lit / (w * h)
    return speckle + 1.5 * max(0.0, abs(ink - 0.5) - 0.25)


def draw_bar(img, box, frac):
    """Outlined capacity bar with a filled portion. box = (x0, y0, x1, y1).

    frac of None draws the empty outline, which is how an asleep dGPU reads.
    """
    x0, y0, x1, y1 = box
    d = ImageDraw.Draw(img)
    d.rectangle([x0, y0, x1, y1], outline=1, fill=0)
    if frac is None:
        return
    inner = x1 - x0 - 2
    frac = min(1.0, max(0.0, frac))
    # A very small fraction rounds to zero width; draw nothing rather than an
    # inverted rectangle (VRAM at 1% of 24G hit exactly this).
    w = int(round(inner * frac)) if inner > 0 else 0
    if w > 0:
        d.rectangle([x0 + 1, y0 + 1, x0 + w, y1 - 1], fill=1)


