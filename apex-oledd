class Source:
    name = 'base'
    fps = 1.0

    def __init__(self, ctx):
        self.ctx = ctx
        self.priority = ctx.cfg['sources'].get(self.name, 0)

    def active(self, now):
        return True

    def render(self, now):
        """Return a 128x40 mode-'1' image, or None to decline the screen."""
        raise NotImplementedError


class NotifySource(Source):
    """Transient frames pushed in over the IPC socket by the `apex-oled` CLI.

    Without this the CLI is useless while the daemon runs: it writes a frame
    and the daemon overwrites it within one tick.
    """
    name = 'notify'
    fps = 10.0

    def __init__(self, ctx):
        super().__init__(ctx)
        self._lock = threading.Lock()
        self._frame = None
        self._expires = 0.0

    def push(self, img, secs):
        with self._lock:
            self._frame = img
            self._expires = time.time() + max(0.1, secs)

    def clear(self):
        with self._lock:
            self._frame = None
            self._expires = 0.0

    def active(self, now):
        with self._lock:
            if self._frame is not None and now >= self._expires:
                self._frame = None
            return self._frame is not None

    def render(self, now):
        with self._lock:
            return self._frame


class GameSource(Source):
    """Thermals and swap thrash while gamemode is active.

    Fullscreen games hide every other readout, so this puts the numbers that
    explain a stutter - GPU load, and whether the machine is paging - on a
    surface that is still visible.
    """
    name = 'game'
    fps = 2.0

    def active(self, now):
        return self.ctx.cfg['game'].get('enabled', True) and self.ctx.s.gamemode()

    def render(self, now):
        s, f = self.ctx.s, self.ctx.fonts
        ui = f.get(self.ctx.cfg['fonts']['ui_size'])
        img = Image.new('1', (WIDTH, HEIGHT), 0)
        gpu = s.gpu()
        r0, r1, r2 = row_steps(ui, 3)

        draw_text(img, (3, r0), 'GPU', ui)
        draw_right(img, 78, r0, f"{gpu['util']}%" if gpu else '--', ui)
        draw_right(img, 125, r0, f"{gpu['temp']}c" if gpu else '--', ui)

        draw_text(img, (3, r1), 'CPU', ui)
        u = s.cpu_util()
        draw_right(img, 78, r1, f'{u:.0f}%' if u is not None else '--', ui)
        t = s.cpu_temp()
        draw_right(img, 125, r1, f'{t}c' if t is not None else '--', ui)

        # The payoff line: sustained swap traffic is the stutter you cannot
        # otherwise see, so it takes the row whenever it is happening.
        rate = s.swap_rate()
        if rate and (rate[0] > 0.05 or rate[1] > 0.05):
            draw_text(img, (3, r2), 'SWAP', ui)
            draw_right(img, 125, r2,
                       f'{rate[0]:.0f}/{rate[1]:.0f} MB/s', ui)
        else:
            mem = s.mem()
            if mem:
                draw_text(img, (3, r2), 'RAM', ui)
                draw_bar(img, (34, r2 + 2, 125, r2 + 8), mem[0] / mem[1])
        return img


class LyricsSource(Source):
    """Now playing + the current synced lyric, from the nowplaying daemon.

    Consumes its state.json rather than re-implementing MPRIS/LRCLIB. That
    file carries an *anchor* (wall clock + track position), so position is
    interpolated locally here and stays smooth without any IPC chatter.
    """
    name = 'lyrics'
    fps = 15.0

    def __init__(self, ctx, path=NOWPLAYING_STATE):
        super().__init__(ctx)
        self.path = path
        self._state = {}
        self._mtime = 0.0
        self._checked = 0.0
        self._art = {}          # cover_file -> dithered thumbnail
        self._paused_since = None

    def _load(self, now):
        if now - self._checked < 0.25:
            return self._state
        self._checked = now
        try:
            m = os.path.getmtime(self.path)
            if m != self._mtime:
                with open(self.path) as f:
                    self._state = json.load(f)
                self._mtime = m
        except (OSError, ValueError):
            self._state = {}
        return self._state

    def active(self, now):
        st = self._load(now)
        if not st or not st.get('title'):
            self._paused_since = None
            return False
        written = st.get('written_at', 0)
        if written and now - written > STATE_STALE_AFTER:
            self._paused_since = None
            return False            # its daemon stopped updating
        if st.get('playing'):
            self._paused_since = None
            return True
        # Paused: hold the now-playing card briefly, then hand the screen to
        # the monitoring view. The pause instant is tracked here rather than
        # read from the state file, because nowplaying keeps rewriting that
        # file while paused and its timestamp would never go stale.
        if self._paused_since is None:
            self._paused_since = now
        return (now - self._paused_since) < self.ctx.cfg['lyrics'].get(
            'pause_hold', 5.0)

    def _position(self, st, now):
        pos = st.get('anchor_pos', 0.0)
        if st.get('playing'):
            pos += now - st.get('anchor_wall', now)
        return max(0.0, pos)

    @staticmethod
    def _line_at(lyrics, pos):
        """(text, start of that line, start of the next) at `pos`.

        start is None before the first line; next is None after the last.
        """
        text, cur_ts, next_ts = '', None, None
        for ts, s in lyrics:
            if ts <= pos:
                text, cur_ts = s, ts
            else:
                next_ts = ts
                break
        return text, cur_ts, next_ts

    @classmethod
    def _current_line(cls, lyrics, pos):
        return cls._line_at(lyrics, pos)[0]

    @classmethod
    def in_gap(cls, lyrics, pos, threshold):
        """True when there is nothing worth reading right now.

        Either the .lrc has an explicit blank at this point, or we are far
        enough from the lines on both sides that the display would just be
        holding a stale line - an intro, an instrumental break, or the outro.
        """
        text, cur_ts, next_ts = cls._line_at(lyrics, pos)
        if not text:
            return True
        since = pos - cur_ts if cur_ts is not None else float('inf')
        until = next_ts - pos if next_ts is not None else float('inf')
        return since > threshold and until > threshold

    def _thumb(self, path, box, mode='auto'):
        """1-bit cover art fitted to box=(w, h), cached per file+box+mode.

        Modes: otsu | threshold | dither | equalize | auto.

        A fixed 128 cutoff throws away any cover that is uniformly dark or
        uniformly bright - 44 of 104 covers here reduced to a near-blank tile.
        `otsu` picks the cutoff from each image's own histogram instead, and
        `auto` renders every candidate and keeps whichever scores best, so
        busy photos can land on dither while graphic covers land on a
        threshold, with no single global choice to regret.
        """
        key = (path, box, mode)
        if key in self._art:
            return self._art[key]
        img = None
        try:
            from PIL import ImageFilter, ImageOps
            w, h = box
            src = Image.open(path).convert('L')
            # Centre-crop to the target aspect, then downscale.
            want = w / h
            have = src.width / src.height
            if have > want:
                nw = int(src.height * want)
                src = src.crop(((src.width - nw) // 2, 0,
                                (src.width + nw) // 2, src.height))
            else:
                nh = int(src.width / want)
                src = src.crop((0, (src.height - nh) // 2,
                                src.width, (src.height + nh) // 2))
            g = src.resize((w, h), Image.LANCZOS)
            # Downscaling this hard destroys the very edges that survive a
            # 1-bit conversion; sharpen at the target size to put them back.
            g = g.filter(ImageFilter.UnsharpMask(radius=1, percent=150, threshold=0))
            g = ImageOps.autocontrast(g)

            def render(m):
                if m == 'otsu':
                    cut = otsu_threshold(g.histogram())
                    return g.point(lambda v: 255 if v > cut else 0, mode='1')
                if m == 'threshold':
                    return g.point(lambda v: 255 if v > 128 else 0, mode='1')
                if m == 'equalize':
                    return ImageOps.equalize(g).convert('1')
                return g.convert('1')          # dither

            if mode == 'auto':
                cands = [(tile_score(render(m)), m) for m in
                         ('otsu', 'threshold', 'dither')]
                cands.sort()
                img = render(cands[0][1])
            else:
                img = render(mode)
        except (OSError, ValueError):
            img = None
        self._art = {key: img}      # only ever need the current track's art
        return img

    def render(self, now):
        st = self._load(now)
        if not st:
            return None
        cfg, f = self.ctx.cfg, self.ctx.fonts
        small = f.get(cfg['fonts']['small_size'])
        lyric_font = f.get(cfg['fonts']['lyric_size'])
        img = Image.new('1', (WIDTH, HEIGHT), 0)
        avail = WIDTH - 4

        pos = self._position(st, now)
        lyrics = st.get('lyrics') or []
        synced = bool(st.get('lyrics_synced') and lyrics)
        line = self._current_line(lyrics, pos) if synced else ''

        artist, title = st.get('artist', ''), st.get('title', '')

        # The now-playing card is the fallback whenever there is no lyric worth
        # showing: no synced lyrics at all, a gap between lines, or paused.
        card = (not synced
                or not st.get('playing')
                or self.in_gap(lyrics, pos, cfg['lyrics'].get('gap_seconds', 8.0)))

        if card:
            # Spend the space on the cover instead. When a lyric *is* live it
            # gets the full width - readability of the words beats decoration.
            art = None
            if cfg['lyrics'].get('album_art', True) and st.get('cover_file'):
                side = int(cfg['lyrics'].get('art_size', 34))
                art = self._thumb(st['cover_file'], (side, side),
                                  cfg['lyrics'].get('art_mode', 'auto'))
            x0 = 3
            if art is not None:
                img.paste(art, (3, 3))
                x0 = 41
            tw = WIDTH - x0 - 3
            base = cfg['fonts']['lyric_size']
            sizes = [base, base - 1, base - 2, base - 3]
            small_h = line_height(small) if artist else 0
            placed = layout_text(title, tw, 36 - small_h, f, sizes, max_lines=2)
            y = 2
            if placed:
                rows, font, lh = placed
                y += max(0, (36 - small_h - lh * len(rows)) // 2)
                for row in rows:
                    draw_text(img, (x0, y), row, font)
                    y += lh
            else:
                draw_text(img, (x0, y), fit(title, tw, lyric_font), lyric_font)
                y += line_height(lyric_font)
            if artist:
                draw_text(img, (x0, min(y, 36 - small_h)),
                          fit(artist, tw, small), small)
        else:
            # Wrapped text beats scaled-up text: the line sits still and can be
            # read at a glance. Pick the largest font and fewest rows that fit;
            # a lyric too big for the space below the header takes the header's
            # row too, because the lyric is the point and the title is not.
            # Scrolling is the last resort - motion is worse than smaller type.
            base = cfg['fonts']['lyric_size']
            sizes = [base, base - 1, base - 2, base - 3]
            # 36 rows of pixels (0..35) sit above the progress bar at y=36.
            # This must not be 35: three 12px rows need exactly 36, and being
            # one pixel short silently downgraded long lyrics to a truncation.
            body_bottom = 36
            header_h = line_height(small)

            placed = layout_text(line, avail, body_bottom - header_h,
                                 f, sizes) if line else None
            show_header = placed is not None
            if line and placed is None:
                placed = layout_text(line, avail, body_bottom, f, sizes)

            if show_header:
                # Static, not a marquee: motion up here fights the lyric for
                # attention, and you end up staring at a fragment like
                # "- Dark Necessities". Title alone if the pair won't fit.
                combined = (f'{artist} - {title}' if artist and title
                            else (title or artist))
                header = (combined if text_width(combined, small) <= avail
                          else fit(title or artist, avail, small))
                draw_centered(img, 0, header, small)

            if placed:
                rows, font, lh = placed
                block = lh * len(rows)
                top = header_h if show_header else 0
                room = (body_bottom - top) - block
                top += max(0, room // 2)
                for i, row in enumerate(rows):
                    draw_centered(img, top + i * lh, row, font)
            elif line:
                draw_centered(img, 14, fit(line, avail, lyric_font), lyric_font)

        dur = st.get('duration') or 0
        if dur > 0:
            frac = max(0.0, min(1.0, pos / dur))
            d = ImageDraw.Draw(img)
            d.line([(2, 38), (WIDTH - 3, 38)], fill=1)          # track
            if frac > 0:                                         # elapsed
                d.rectangle([2, 36, 2 + int((WIDTH - 5) * frac), 38], fill=1)
        return img


class IdleSource(Source):
    """Capacity bars over CPU and GPU rows. The default when nothing claims it."""
    name = 'idle'
    fps = 1.0

    # Column right-edges. Values are right-aligned to these so a jump from
    # 99W to 118W doesn't shove the row sideways. Margins are 3/125 rather
    # than 2/126 to survive the +/-2 px burn-in shift without clipping.
    COL_TEMP, COL_UTIL, COL_WATT = 57, 91, 125

    BAR_LABELS = {'ram': 'RAM', 'vram': 'VRM', 'swap': 'SWP', 'disk': 'DSK'}

    def _bar_frac(self, kind):
        s = self.ctx.s
        if kind == 'ram':
            m = s.mem()
            return (m[0] / m[1]) if m else None
        if kind == 'vram':
            g = s.gpu()
            t = g.get('vram_total')
            return (g['vram_used'] / t) if t else None
        if kind == 'swap':
            sw = s.swap()
            return (sw[0] / sw[1]) if sw and sw[1] else None
        if kind == 'disk':
            try:
                st = os.statvfs(os.path.expanduser('~'))
                return 1.0 - (st.f_bavail / st.f_blocks) if st.f_blocks else None
            except OSError:
                return None
        return None

    def render(self, now):
        s, f = self.ctx.s, self.ctx.fonts
        ui = f.get(self.ctx.cfg['fonts']['ui_size'])
        img = Image.new('1', (WIDTH, HEIGHT), 0)
        gpu = s.gpu()
        rows = row_steps(ui, 3)

        # Top row: capacity bars. Bars beat numbers for "how full is it".
        kinds = self.ctx.cfg['idle'].get('bars', ['ram', 'vram'])[:2]
        half = WIDTH // 2
        for i, kind in enumerate(kinds):
            label = self.BAR_LABELS.get(kind, kind[:3].upper())
            x = 3 + i * half
            draw_text(img, (x, rows[0]), label, ui)
            lw = text_width(label, ui)
            draw_bar(img, (x + lw + 3, 2, x + half - 6, 8), self._bar_frac(kind))

        def row(y, label, temp, util, watts):
            draw_text(img, (3, y), label, ui)
            draw_right(img, self.COL_TEMP, y,
                       f'{temp:.0f}c' if temp is not None else '--', ui)
            draw_right(img, self.COL_UTIL, y,
                       f'{util:.0f}%' if util is not None else '--', ui)
            draw_right(img, self.COL_WATT, y,
                       f'{watts:.0f}W' if watts is not None else '--', ui)

        row(rows[1], 'CPU', s.cpu_temp(), s.cpu_util(), s.cpu_watts())
        # An asleep dGPU reports nothing rather than being woken up for a readout.
        row(rows[2], 'GPU', gpu.get('temp'), gpu.get('util'), gpu.get('watts'))
        return img


