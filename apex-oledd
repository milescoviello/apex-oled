class NotifySource(Source):
    """Transient frames pushed in over the IPC socket by the `apex-oled` CLI.

    Without this the CLI is useless while the daemon runs: it writes a frame
    and the daemon overwrites it within one tick.
    """
    name = 'notify'
    fps = 10.0

    def __init__(self, ctx):
        super().__init__(ctx)
        self._lock = threading.Lock()
        self._frame = None
        self._expires = 0.0

    def push(self, img, secs):
        with self._lock:
            self._frame = img
            self._expires = time.time() + max(0.1, secs)

    def clear(self):
        with self._lock:
            self._frame = None
            self._expires = 0.0

    def active(self, now):
        with self._lock:
            if self._frame is not None and now >= self._expires:
                self._frame = None
            return self._frame is not None

    def render(self, now):
        with self._lock:
            return self._frame


def mangohud_log_dir(cfg):
    d = cfg['game'].get('mangohud_logs')
    if d:
        return os.path.expanduser(d)
    run = os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}'
    return os.path.join(run, 'mangohud')


class MangoHudFps:
    """Live frame rate, read from the tail of MangoHud's CSV log.

    A game's frame rate is invisible from outside the process; MangoHud is the
    layer already sitting in the present path. With autostart_log it appends a
    row per log_interval and flushes each one, so the newest file's last line
    is the current FPS. A log that has stopped growing is a game that closed.
    """
    STALE = 3.0             # not written for this long: the game has exited
    RESCAN = 2.0            # how often to look for a newer log file
    PRUNE_AGE = 2 * 86400   # old session logs; the folder is tmpfs anyway

    def __init__(self, cfg):
        self.dir = mangohud_log_dir(cfg)
        self._log = None
        self._scanned = 0.0
        try:
            # MangoHud does not create output_folder; a missing one just
            # means no log, silently.
            os.makedirs(self.dir, exist_ok=True)
        except OSError:
            pass

    def _scan(self, now):
        newest, best = None, 0.0
        try:
            entries = list(os.scandir(self.dir))
        except OSError:
            return None
        for e in entries:
            if not e.name.endswith('.csv'):
                continue
            try:
                m = e.stat().st_mtime
            except OSError:
                continue
            if now - m > self.PRUNE_AGE:
                try:
                    os.unlink(e.path)
                except OSError:
                    pass
            elif not e.name.endswith('_summary.csv') and m > best:
                newest, best = e.path, m
        return newest

    def read(self, now):
        if now - self._scanned >= self.RESCAN:
            self._scanned = now
            self._log = self._scan(now)
        if not self._log:
            return None
        try:
            st = os.stat(self._log)
            if now - st.st_mtime > self.STALE:
                return None
            with open(self._log, 'rb') as f:
                f.seek(max(0, st.st_size - 512))
                tail = f.read().decode('ascii', 'replace')
        except OSError:
            return None
        # The last element is whatever follows the final newline: empty, or a
        # row caught half-written. The one before it is the newest whole row.
        rows = tail.split('\n')
        if len(rows) < 2:
            return None
        try:
            fps = float(rows[-2].split(',', 1)[0])
        except ValueError:
            return None             # still on the header lines
        return fps if fps >= 0 else None


class GameSource(Source):
    """Frame rate, thermals and swap thrash while a game is running.

    Fullscreen games hide every other readout, so this puts the numbers that
    explain a stutter - FPS, GPU load, and whether the machine is paging - on a
    surface that is still visible. A game counts as running while gamemode is
    active or while MangoHud is writing a log.
    """
    name = 'game'
    fps = 2.0

    SWAP_ON = 0.05          # MiB/s that counts as "we are paging"
    SWAP_HOLD = 10.0        # keep the swap row this long after the last burst
    FPS_COL = 40            # width of the big-number column
    FPS_SIZES = (26, 22, 18, 15)

    def __init__(self, ctx):
        super().__init__(ctx)
        self._swap_until = 0.0
        self._swap_peak = 0.0
        self._mango = MangoHudFps(ctx.cfg)

    def active(self, now):
        if not self.ctx.cfg['game'].get('enabled', True):
            return False
        return self.ctx.s.gamemode() or self._mango.read(now) is not None

    def _swapping(self, now):
        """Latched peak swap rate (MiB/s), or None when not paging.

        Latched, not instantaneous: paging is bursty, and testing the rate
        directly flipped the row against the RAM bar twice a second. Peak
        rather than the live sample, which is unreadable redrawn at 2 Hz.
        """
        rate = self.ctx.s.swap_rate()
        if rate and (rate[0] > self.SWAP_ON or rate[1] > self.SWAP_ON):
            self._swap_until = now + self.SWAP_HOLD
            self._swap_peak = max(self._swap_peak, rate[0], rate[1])
        if now >= self._swap_until:
            self._swap_peak = 0.0
            return None
        return self._swap_peak

    def render(self, now):
        fps = self._mango.read(now)
        if fps is not None:
            return self._render_fps(now, fps)
        s, f = self.ctx.s, self.ctx.fonts
        ui = f.get(self.ctx.cfg['fonts']['ui_size'])
        img = Image.new('1', (WIDTH, HEIGHT), 0)
        gpu = s.gpu()
        r0, r1, r2 = row_steps(ui, 3)

        draw_text(img, (3, r0), 'GPU', ui)
        draw_right(img, 78, r0, f"{gpu['util']}%" if gpu else '--', ui)
        draw_right(img, 125, r0, f"{gpu['temp']}c" if gpu else '--', ui)

        draw_text(img, (3, r1), 'CPU', ui)
        u = s.cpu_util()
        draw_right(img, 78, r1, f'{u:.0f}%' if u is not None else '--', ui)
        t = s.cpu_temp()
        draw_right(img, 125, r1, f'{t}c' if t is not None else '--', ui)

        # The payoff line: sustained swap traffic is the stutter you cannot
        # otherwise see, so it takes the row whenever it is happening.
        peak = self._swapping(now)
        if peak is not None:
            draw_text(img, (3, r2), 'SWAP', ui)
            draw_right(img, 125, r2, f'peak {peak:.0f} MB/s', ui)
        else:
            mem = s.mem()
            if mem:
                draw_text(img, (3, r2), 'RAM', ui)
                draw_bar(img, (34, r2 + 2, 125, r2 + 8), mem[0] / mem[1])
        return img

    def _render_fps(self, now, fps):
        """Big FPS on the left; the three stat rows squeezed to the right."""
        s, f = self.ctx.s, self.ctx.fonts
        ui = f.get(self.ctx.cfg['fonts']['ui_size'])
        img = Image.new('1', (WIDTH, HEIGHT), 0)
        r0, r1, r2 = row_steps(ui, 3)
        col = self.FPS_COL

        num = f'{fps:.0f}'
        big = next((f.get(sz) for sz in self.FPS_SIZES
                    if text_width(num, f.get(sz)) <= col - 2),
                   f.get(self.FPS_SIZES[-1]))
        # Place by the glyphs' ink, not the font's line box: digits have no
        # descenders, so line_height() would leave the number floating high.
        x0, y0, x1, y1 = big.getbbox(num)
        draw_text(img, ((col - (x1 - x0)) // 2 - x0, r1 + line_height(ui) - y1),
                  num, big)
        draw_centered(img, r2, 'fps', ui, 0, col)

        x = col + 4
        gpu = s.gpu()
        draw_text(img, (x, r0), 'GPU', ui)
        draw_right(img, 100, r0, f"{gpu['util']}%" if gpu else '--', ui)
        draw_right(img, 125, r0, f"{gpu['temp']}c" if gpu else '--', ui)

        draw_text(img, (x, r1), 'CPU', ui)
        u = s.cpu_util()
        draw_right(img, 100, r1, f'{u:.0f}%' if u is not None else '--', ui)
        t = s.cpu_temp()
        draw_right(img, 125, r1, f'{t}c' if t is not None else '--', ui)

        peak = self._swapping(now)
        if peak is not None:
            draw_text(img, (x, r2), 'SWAP', ui)
            draw_right(img, 125, r2, f'{peak:.0f}M/s', ui)
        else:
            mem = s.mem()
            if mem:
                draw_text(img, (x, r2), 'RAM', ui)
                draw_bar(img, (x + 26, r2 + 2, 125, r2 + 8), mem[0] / mem[1])
        return img


def si_k(n):
    """201k / 1.4M style short numbers - 128px has no room for 200759."""
    n = float(n)
    if n >= 1e6:
        return f'{n / 1e6:.1f}M'
    if n >= 1000:
        return f'{n / 1000:.0f}k'
    return f'{n:.0f}'


def short_secs(s):
    s = max(0, int(s))
    if s < 60:
        return f'{s}s'
    if s < 3600:
        return f'{s // 60}m{s % 60:02d}s' if s < 600 else f'{s // 60}m'
    return f'{s // 3600}h{(s % 3600) // 60:02d}m'


def qwen_view(**kw):
    """What QwenSource draws, whichever server it was read from.

    state: off (no server running), unloaded (server up, weights not in
    memory), idle, loading (a request is waiting on the weights), reading (a
    prefill), generating. Unknown values are None.
    """
    v = {'backend': None, 'up': False, 'broken': False, 'state': 'off',
         'prefill': None,       # {'frac', 'done', 'total', 'rate', 'eta', 'elapsed'}
         'live_tps': None,      # decode rate of the turn in flight
         'last_tps': None,      # the previous turn's average
         'gpu': None,           # {'util_pct', 'power_w', 'temp_c'}
         'ctx': None}           # (tokens resident, window size)
    v.update(kw)
    return v


BUSY_STATES = ('loading', 'reading', 'generating')


class DecodeRate:
    """Live tok/s from a turn's running token count, sampled once a poll.

    Smoothed: raw samples swing 18-25 tok/s between ticks on llama.cpp, and
    40-100 on Strata, whose speculative decoding lands tokens in bursts.
    """

    def __init__(self):
        self._last = None           # (t, n)
        self.tps = None

    def update(self, n, now):
        """n: tokens generated so far this turn, None when nothing is."""
        prev, self._last = self._last, (now, n)
        if n is None:
            self._last = self.tps = None
        elif prev and now > prev[0]:
            if n < prev[1]:
                self.tps = None             # a new turn began
            elif n > prev[1]:
                r = (n - prev[1]) / (now - prev[0])
                self.tps = r if self.tps is None else 0.6 * self.tps + 0.4 * r
        return self.tps


class LlamaBackend:
    """llama-server (qwen38, behind qwen-claude-proxy), read through
    `qwen-status --json` plus llama-server's own /slots.

    `qwen-status --json` is the contract; its log parsing and nvidia-smi calls
    stay on its side of the fence.
    """
    name = 'llama'
    # qwen-status shells out to nvidia-smi on every call, so idle polling is
    # kept slow.
    idle_poll = 5.0

    def __init__(self, ctx):
        self.ctx = ctx
        self._ctx_used = None       # (tokens resident, n_ctx) from /slots
        self._processing = False    # a turn is in flight
        self._rate = DecodeRate()

    def _poll_slots(self):
        """True context occupancy, straight from llama-server.

        `prefill.tokens_done` is the *incremental* prefill: with prompt
        caching a 210k-token conversation can report 979, because only 979
        tokens were new. That makes it useless as "how full is the window" -
        it read 0.4% while the window was 92% full. /slots reports
        n_prompt_tokens, which is the whole prompt actually resident.
        """
        url = self.ctx.cfg['qwen'].get('slots_url')
        if not url:
            return
        try:
            import urllib.request
            with urllib.request.urlopen(url, timeout=3) as r:
                slots = json.load(r)
            slot = (slots if isinstance(slots, list) else [slots])[0]
            used, total = slot.get('n_prompt_tokens'), slot.get('n_ctx')
            if used is not None and total:
                self._ctx_used = (used, total)
            self._processing = bool(slot.get('is_processing'))

            # Live decode rate. The status contract says none is available,
            # but /slots carries n_decoded for the in-flight turn, and
            # differencing it gives the real current speed - which is what
            # you want mid-generation. gen_tok_s is the previous turn's
            # average and can be minutes stale.
            n = ((slot.get('next_token') or [{}])[0] or {}).get('n_decoded')
            self._rate.update(n if self._processing else None, time.time())
        except Exception:
            pass            # server down or endpoint absent: fall back below

    def poll(self):
        """A qwen_view, or None when qwen-status could not be read at all."""
        self._poll_slots()
        cmd = self.ctx.cfg['qwen'].get('command', 'qwen-status')
        try:
            out = subprocess.run([cmd, '--json'], capture_output=True,
                                 text=True, timeout=10).stdout
            st = json.loads(out)
            if not isinstance(st, dict):
                raise ValueError('not an object')
        except (OSError, ValueError, subprocess.SubprocessError):
            # Missing script, dead server, truncated log mid-restart: all mean
            # "no idea", which must yield rather than wedge the display.
            return None
        return self.view(st)

    def view(self, st):
        if not st.get('model_up'):
            # The proxy only exists to front llama-server, so "proxy up, model
            # down" means something died. Both down is just the stack switched
            # off - the normal state at boot - and is not worth a screen.
            return qwen_view(backend=self.name, broken=bool(st.get('proxy_up')))

        pf = st.get('prefill') or {}
        ctx_size = st.get('ctx_size') or 0
        # Only trust an incomplete prefill when the server agrees something is
        # running. qwen-status leaves the last prefill behind when a request
        # is interrupted - it sat at "72% complete, eta 63s" with the server
        # idle - and believing it pinned this source active forever, locking
        # every other view off the panel. With no /slots to cross-check
        # against, it is all there is.
        reading = bool(pf) and not pf.get('complete') and (
            self._processing or self._ctx_used is None)
        prefill = None
        if reading:
            prefill = {
                'frac': pf.get('fraction') or 0.0,
                'done': pf.get('tokens_done') or 0,
                # This prefill's own workload, not the window: with prompt
                # caching only the uncached tail gets processed, so "979/229k"
                # would be nonsense. tokens_total is derived and wobbles a
                # little, which is fine at this precision.
                'total': pf.get('tokens_total') or ctx_size,
                'rate': pf.get('tok_per_s'),
                'eta': pf.get('eta_s'),
                'elapsed': pf.get('elapsed_s'),
            }
        ctx = self._ctx_used
        if ctx is None and pf.get('tokens_done') and ctx_size:
            ctx = (pf['tokens_done'], ctx_size)     # /slots unavailable
        return qwen_view(
            backend=self.name, up=True, prefill=prefill, ctx=ctx,
            state='reading' if reading else
                  'generating' if self._processing else 'idle',
            live_tps=self._rate.tps, last_tps=st.get('gen_tok_s'),
            gpu=st.get('gpu') or None)


class StrataBackend:
    """Strata (flashnext-serve), the server omp talks to directly.

    No log parsing or nvidia-smi: /metrics already says what the server is
    doing (reading the prompt, generating), how far along it is, and how the
    GPU is doing, from its own bookkeeping. /health adds whether the weights
    are in memory - Strata frees the GPU after a quiet spell and reloads on
    the next request, which takes about a minute.
    """
    name = 'strata'
    # Two localhost GETs. Cheap, and omp's turns are often only seconds long.
    idle_poll = 2.0

    def __init__(self, ctx):
        self.ctx = ctx
        self._rate = DecodeRate()

    @staticmethod
    def _get(url):
        import urllib.request
        with urllib.request.urlopen(url, timeout=3) as r:
            v = json.load(r)
        return v if isinstance(v, dict) else {}

    def poll(self):
        """A qwen_view; stack off when the server does not answer."""
        base = (self.ctx.cfg['qwen'].get('strata_url') or '').rstrip('/')
        if not base:
            return None
        try:
            health = self._get(base + '/health')
        except Exception:
            self._rate.update(None, time.time())
            return qwen_view(backend=self.name)
        try:
            metrics = self._get(base + '/metrics')
        except Exception:
            metrics = {}        # up but not saying more (an API key, say)
        return self.view(health, metrics, time.time())

    def view(self, health, metrics, now):
        live = metrics.get('live') or {}
        hw = metrics.get('hardware') or {}
        reqs = metrics.get('requests') or []
        last = reqs[0] if reqs and isinstance(reqs[0], dict) else {}
        loaded = health.get('loaded') is not False
        window = health.get('max_context') or (
            metrics.get('engine') or {}).get('max_context')

        state = live.get('state')
        if state == 'reading' and not loaded:
            state = 'loading'           # a request woke the unloaded model
        elif state not in ('reading', 'generating', 'unloaded'):
            state = 'idle' if loaded else 'unloaded'

        prefill = None
        if state == 'reading':
            # prompt_read is the position reached, cached prefix included, so
            # a turn that reuses most of its context starts the bar far along.
            # The rate counts only fresh tokens, so the ETA is right either
            # way. Both are null until the first chunk lands - about 9s into a
            # 4k-token prompt - so until then elapsed time is all there is.
            total = live.get('prompt_total') or live.get('prompt_tokens')
            done = live.get('prompt_read') or 0
            rate = live.get('prefill_tok_s_mean') or None
            prefill = {
                'frac': min(1.0, done / total) if total else 0.0,
                'done': done, 'total': total, 'rate': rate,
                'eta': (total - done) / rate if rate and total else None,
                'elapsed': live.get('elapsed_s'),
            }

        if state == 'generating':
            # Strata reports a tok_s of its own, but over a short window that
            # swings 40-100 under speculative decoding; differencing the
            # count once a poll and smoothing it reads steadier.
            self._rate.update(live.get('generated') or 0, now)
            used = (live.get('prompt_tokens') or 0) + (live.get('generated') or 0)
        else:
            self._rate.update(None, now)
            used = (live.get('prompt_read') if state == 'reading' else
                    (last.get('prompt_tokens') or 0) + (last.get('output_tokens') or 0))

        gpu = None
        if hw.get('gpu_util') is not None:
            gpu = {'util_pct': hw.get('gpu_util'), 'power_w': hw.get('gpu_power'),
                   'temp_c': hw.get('gpu_temp')}
        return qwen_view(
            backend=self.name, up=True, state=state, prefill=prefill,
            live_tps=self._rate.tps, last_tps=last.get('decode_tok_s'),
            gpu=gpu, ctx=(used, window) if used and window else None)


def process_running(names):
    """True when a process was started as one of `names`, by basename.

    argv[1] counts too, so programs run by an interpreter are found: omp is
    `bun /path/to/omp`.
    """
    want = set(names)
    if not want:
        return False
    for pid in os.listdir('/proc'):
        if not pid.isdigit():
            continue
        try:
            with open(f'/proc/{pid}/cmdline', 'rb') as f:
                argv = f.read().split(b'\0')[:2]
        except OSError:
            continue
        if any(os.path.basename(a.decode(errors='replace')) in want for a in argv):
            return True
    return False


class QwenSource(Source):
    """Local LLM inference stats, chiefly prefill progress.

    A large session spends minutes ingesting its prompt before emitting a
    single token, and nothing on screen distinguishes "working" from "hung".
    That is the state worth surfacing, so this claims the panel only while
    something is actually happening (see active()) and yields to the lyrics
    view the rest of the time - the stack is idle most of the day.

    Reading the server is a backend's job; each turns its own server's
    numbers into a qwen_view, and everything below draws only that. Strata
    is what omp uses; llama.cpp is the older qwen38 stack. Polling happens on
    a thread because it involves a subprocess and HTTP, and the render loop
    must not block on either.
    """
    name = 'qwen'
    fps = 2.0

    GEN_FRESH = 10.0        # keep showing a finished turn for this long
    # MODEL DOWN is an inverted frame - nearly every pixel lit - and with omp
    # left open and Strata stopped it can stay true for hours, which is
    # exactly the burn-in the rest of the daemon works to avoid. Interrupt
    # for this long, then yield; pinning the view still shows it.
    ALARM_HOLD = 120.0
    BUSY_POLL = 1.0
    # A dead server can stay dead for hours with omp left open, and each
    # check may run qwen-status and so nvidia-smi; a few seconds to notice it
    # coming back is plenty.
    BROKEN_POLL = 5.0
    # Stack switched off: nothing to show, and qwen-status shells out to
    # nvidia-smi on every call, so check back only occasionally. A prefill
    # takes minutes, so noticing the stack 30s late costs nothing.
    OFF_POLL = 30.0

    def __init__(self, ctx):
        super().__init__(ctx)
        self._view = None
        self._backends = {b.name: b for b in (StrataBackend(ctx), LlamaBackend(ctx))}
        self._gen_seen = 0.0
        self._was_busy = False
        self._broken_since = None
        self._thread = threading.Thread(target=self._loop, daemon=True)
        self._thread.start()

    def _poll_once(self):
        cfg = self.ctx.cfg['qwen']
        want = cfg.get('backend', 'auto')
        order = [self._backends[want]] if want in self._backends else \
            list(self._backends.values())
        view = None
        for be in order:
            v = be.poll()
            if v is None:
                continue                    # could not tell: try the next
            if v['up']:
                view = v
                break
            if view is None or v['broken']:
                view = v                    # nothing up; keep the worst news
        # A client of the local model with no server answering is the same
        # failure "proxy up, model down" was for llama.cpp: its requests are
        # going nowhere. Without one, both down is just the stack switched
        # off, the normal state at boot.
        if view is not None and not view['up'] and not view['broken'] \
                and process_running(cfg.get('clients') or []):
            view = {**view, 'broken': True}
        self._set_view(view)

    def _set_view(self, view):
        # "A turn just finished" is the server leaving a busy state, not a
        # change in the reported rate. gen_tok_s is a rolling figure that
        # wobbles between samples (24.9 -> 24.3 with nothing running), and
        # treating each wobble as news made this source seize the screen for
        # 10s, release it, and seize it again - ping-ponging with the lyrics
        # view.
        busy = bool(view) and view['state'] in BUSY_STATES
        if self._was_busy and not busy:
            self._gen_seen = time.time()
        self._was_busy = busy
        if not (view and view['broken']):
            self._broken_since = None
        elif self._broken_since is None:
            self._broken_since = time.time()
        self._view = view

    def _loop(self):
        while not self.ctx.stop.is_set():
            self._poll_once()
            v = self._view or qwen_view()
            if v['broken']:
                wait = self.BROKEN_POLL
            elif v['state'] in BUSY_STATES:
                wait = self.BUSY_POLL
            elif not v['up']:
                wait = self.OFF_POLL
            else:
                wait = self._backends[v['backend']].idle_poll
            if self.ctx.stop.wait(wait):
                break

    def active(self, now):
        if not self.ctx.cfg['qwen'].get('enabled', True):
            return False
        v = self._view
        if not v:
            return False
        if v['broken']:
            # a dead server is worth interrupting for, but not indefinitely
            return now - (self._broken_since or now) < self.ALARM_HOLD
        if not v['up']:
            return False                    # stack off: nothing to report
        if v['state'] in BUSY_STATES:
            return True                     # prefilling or generating right now
        return (now - self._gen_seen) < self.GEN_FRESH

    def render(self, now):
        v = self._view
        if not v:
            return None
        f = self.ctx.fonts
        ui = f.get(self.ctx.cfg['fonts']['ui_size'])
        big = f.get(self.ctx.cfg['fonts']['lyric_size'])
        img = Image.new('1', (WIDTH, HEIGHT), 0)
        r0, r1, r2 = row_steps(ui, 3)

        if v['broken']:
            # Inverted so a dead server is unmistakable at a glance rather
            # than being one more line of small text. Draw white-on-black as
            # usual and flip the finished frame - drawing onto a white canvas
            # instead renders white-on-white and inverts to a blank panel.
            draw_centered(img, 4, 'QWEN', ui)
            draw_centered(img, 4 + line_height(ui), 'MODEL DOWN', big)
            return ImageOps.invert(img.convert('L')).convert('1')
        if not v['up'] or v['state'] in ('loading', 'unloaded'):
            # Switched off and unloaded are only reachable when pinned; they
            # are not alarms. Loading is a request waiting on the weights.
            draw_centered(img, 4, 'QWEN', ui)
            draw_centered(img, 4 + line_height(ui),
                          v['state'] if v['up'] else 'stack off', big)
            return img

        pf = v['prefill']
        if v['state'] == 'reading' and pf:
            frac = pf.get('frac') or 0.0
            draw_text(img, (3, r0), 'FILL', ui)
            draw_centered(img, r0, f'{frac * 100:.0f}%', ui, 40, 88)
            rate = pf.get('rate')
            draw_right(img, 125, r0, f'{rate:.0f}/s' if rate else '--', ui)

            draw_bar(img, (3, r1 + 2, 125, r1 + 9), frac)

            done, total = pf.get('done') or 0, pf.get('total')
            draw_text(img, (3, r2), f'{si_k(done)}/{si_k(total)}' if total
                      else si_k(done), ui)
            eta, elapsed = pf.get('eta'), pf.get('elapsed')
            if eta is not None:
                draw_right(img, 125, r2, f'eta {short_secs(eta)}', ui)
            elif elapsed is not None:
                # No rate yet, so no ETA - but a clock that keeps moving is
                # what tells "working" from "hung" in the meantime.
                draw_right(img, 125, r2, short_secs(elapsed), ui)
            return img

        # generating, or freshly finished
        draw_text(img, (3, r0), 'QWEN', ui)
        if v['live_tps']:
            rate = f"{v['live_tps']:.1f} t/s"
        elif v['last_tps'] is not None:
            # "last" so a stale average never masquerades as the current speed
            rate = f"{v['last_tps']:.0f} t/s last"
        else:
            rate = 'idle'
        draw_right(img, 125, r0, rate, ui)

        gpu = v['gpu']
        if gpu:
            draw_text(img, (3, r1), 'GPU', ui)
            draw_centered(img, r1, f"{gpu.get('util_pct') or 0}%", ui, 30, 70)
            draw_centered(img, r1, f"{gpu.get('power_w') or 0:.0f}W", ui, 66, 102)
            draw_right(img, 125, r1, f"{gpu.get('temp_c') or 0}c", ui)
        used, total = v['ctx'] or (None, None)
        if used and total:
            draw_text(img, (3, r2), f'ctx {si_k(used)}/{si_k(total)}', ui)
            draw_bar(img, (76, r2 + 2, 125, r2 + 9), used / total)
        return img


class VideoSource(Source):
    """Play a packed frame file in sync with a track, when that track plays.

    The point of doing this in the daemon rather than with `apex-oled play` is
    that nowplaying publishes an *anchored* position, so the frame index comes
    from the track clock rather than a local one. It therefore stays in sync
    across pause, resume and seeking, instead of drifting the moment you touch
    the transport.

    render() returns a raw framebuffer rather than an image: the frames are
    already packed on disk, and unpacking only to repack them would be silly.
    """
    name = 'video'
    fps = 30.0

    def __init__(self, ctx, state_path=NOWPLAYING_STATE):
        super().__init__(ctx)
        self.state_path = state_path
        self._state, self._mtime, self._checked = {}, 0.0, 0.0
        self._maps = {}         # path -> (mmap, frame count)
        self._match = None      # (fb path, fps) for the current track

    def _load(self, now):
        if now - self._checked < 0.25:
            return self._state
        self._checked = now
        try:
            m = os.path.getmtime(self.state_path)
            if m != self._mtime:
                with open(self.state_path) as f:
                    self._state = json.load(f)
                self._mtime = m
        except (OSError, ValueError):
            self._state = {}
        return self._state

    def _frames(self, path):
        """mmap the frame file - 4 MB per video is not worth resident memory."""
        if path not in self._maps:
            import mmap
            try:
                f = open(path, 'rb')
                mm = mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ)
                self._maps[path] = (mm, len(mm) // apex.FB_LEN)
            except (OSError, ValueError):
                self._maps[path] = (None, 0)
        return self._maps[path]

    def _lookup(self, st):
        """First configured track whose name appears in the title."""
        title = (st.get('title') or '').lower()
        if not title:
            return None
        for needle, path in (self.ctx.cfg['video'].get('tracks') or {}).items():
            if needle.lower() in title:
                path = os.path.expanduser(path)
                if os.path.exists(path):
                    return path
        return None

    def active(self, now):
        cfg = self.ctx.cfg['video']
        if not cfg.get('enabled', True):
            return False
        st = self._load(now)
        if not st or not st.get('playing'):
            return False
        written = st.get('written_at', 0)
        if written and now - written > STATE_STALE_AFTER:
            return False
        self._match = self._lookup(st)
        return self._match is not None

    def render(self, now):
        if not self._match:
            return None
        mm, count = self._frames(self._match)
        if not count:
            return None
        st = self._state
        pos = st.get('anchor_pos', 0.0)
        if st.get('playing'):
            pos += now - st.get('anchor_wall', now)
        # Offset lets a video be aligned against a track that has a different
        # intro length to the source it was ripped from.
        pos += float(self.ctx.cfg['video'].get('offset', 0.0))
        i = int(pos * float(self.ctx.cfg['video'].get('fps', 30.0)))
        if i < 0 or i >= count:
            return None                 # before the start or past the end
        return bytes(mm[i * apex.FB_LEN:(i + 1) * apex.FB_LEN])


class LyricsSource(Source):
    """Now playing + the current synced lyric, from the nowplaying daemon.

    Consumes its state.json rather than re-implementing MPRIS/LRCLIB. That
    file carries an *anchor* (wall clock + track position), so position is
    interpolated locally here and stays smooth without any IPC chatter.
    """
    name = 'lyrics'
    fps = 15.0

    def __init__(self, ctx, path=NOWPLAYING_STATE):
        super().__init__(ctx)
        self.path = path
        self._state = {}
        self._mtime = 0.0
        self._checked = 0.0
        self._art = {}          # cover_file -> dithered thumbnail
        self._paused_since = None

    def _load(self, now):
        if now - self._checked < 0.25:
            return self._state
        self._checked = now
        try:
            m = os.path.getmtime(self.path)
            if m != self._mtime:
                with open(self.path) as f:
                    self._state = json.load(f)
                self._mtime = m
        except (OSError, ValueError):
            self._state = {}
        return self._state

    def active(self, now):
        st = self._load(now)
        if not st or not st.get('title'):
            self._paused_since = None
            return False
        written = st.get('written_at', 0)
        if written and now - written > STATE_STALE_AFTER:
            self._paused_since = None
            return False            # its daemon stopped updating
        if st.get('playing'):
            self._paused_since = None
            return True
        # Paused: hold the now-playing card briefly, then hand the screen to
        # the monitoring view. The pause instant is tracked here rather than
        # read from the state file, because nowplaying keeps rewriting that
        # file while paused and its timestamp would never go stale.
        if self._paused_since is None:
            self._paused_since = now
        return (now - self._paused_since) < self.ctx.cfg['lyrics'].get(
            'pause_hold', 5.0)

    def _position(self, st, now):
        pos = st.get('anchor_pos', 0.0)
        if st.get('playing'):
            pos += now - st.get('anchor_wall', now)
        return max(0.0, pos)

    @staticmethod
    def _line_at(lyrics, pos):
        """(text, start of that line, start of the next) at `pos`.

        start is None before the first line; next is None after the last.
        """
        text, cur_ts, next_ts = '', None, None
        for ts, s in lyrics:
            if ts <= pos:
                text, cur_ts = s, ts
            else:
                next_ts = ts
                break
        return text, cur_ts, next_ts

    @classmethod
    def _current_line(cls, lyrics, pos):
        return cls._line_at(lyrics, pos)[0]

    @classmethod
    def in_gap(cls, lyrics, pos, threshold):
        """True when there is nothing worth reading right now.

        Either the .lrc has an explicit blank at this point, or we are far
        enough from the lines on both sides that the display would just be
        holding a stale line - an intro, an instrumental break, or the outro.
        """
        text, cur_ts, next_ts = cls._line_at(lyrics, pos)
        if not text:
            return True
        since = pos - cur_ts if cur_ts is not None else float('inf')
        until = next_ts - pos if next_ts is not None else float('inf')
        return since > threshold and until > threshold

    def _thumb(self, path, box, mode='auto'):
        """1-bit cover art fitted to box=(w, h), cached per file+box+mode.

        Modes: otsu | threshold | dither | equalize | auto.

        A fixed 128 cutoff throws away any cover that is uniformly dark or
        uniformly bright - 44 of 104 covers here reduced to a near-blank tile.
        `otsu` picks the cutoff from each image's own histogram instead, and
        `auto` renders every candidate and keeps whichever scores best, so
        busy photos can land on dither while graphic covers land on a
        threshold, with no single global choice to regret.
        """
        key = (path, box, mode)
        if key in self._art:
            return self._art[key]
        img = None
        try:
            from PIL import ImageFilter, ImageOps
            w, h = box
            src = Image.open(path).convert('L')
            # Centre-crop to the target aspect, then downscale.
            want = w / h
            have = src.width / src.height
            if have > want:
                nw = int(src.height * want)
                src = src.crop(((src.width - nw) // 2, 0,
                                (src.width + nw) // 2, src.height))
            else:
                nh = int(src.width / want)
                src = src.crop((0, (src.height - nh) // 2,
                                src.width, (src.height + nh) // 2))
            g = src.resize((w, h), Image.LANCZOS)
            # Downscaling this hard destroys the very edges that survive a
            # 1-bit conversion; sharpen at the target size to put them back.
            g = g.filter(ImageFilter.UnsharpMask(radius=1, percent=150, threshold=0))
            g = ImageOps.autocontrast(g)

            def render(m):
                if m == 'otsu':
                    cut = otsu_threshold(g.histogram())
                    return g.point(lambda v: 255 if v > cut else 0, mode='1')
                if m == 'threshold':
                    return g.point(lambda v: 255 if v > 128 else 0, mode='1')
                if m == 'equalize':
                    return ImageOps.equalize(g).convert('1')
                return g.convert('1')          # dither

            if mode == 'auto':
                cands = [(tile_score(render(m)), m) for m in
                         ('otsu', 'threshold', 'dither')]
                cands.sort()
                img = render(cands[0][1])
            else:
                img = render(mode)
        except (OSError, ValueError):
            img = None
        self._art = {key: img}      # only ever need the current track's art
        return img

    def render(self, now):
        st = self._load(now)
        if not st:
            return None
        cfg, f = self.ctx.cfg, self.ctx.fonts
        small = f.get(cfg['fonts']['small_size'])
        lyric_font = f.get(cfg['fonts']['lyric_size'])
        img = Image.new('1', (WIDTH, HEIGHT), 0)
        avail = WIDTH - 4

        pos = self._position(st, now)
        lyrics = st.get('lyrics') or []
        synced = bool(st.get('lyrics_synced') and lyrics)
        line = self._current_line(lyrics, pos) if synced else ''

        artist, title = st.get('artist', ''), st.get('title', '')

        # The now-playing card is the fallback whenever there is no lyric worth
        # showing: no synced lyrics at all, a gap between lines, or paused.
        card = (not synced
                or not st.get('playing')
                or self.in_gap(lyrics, pos, cfg['lyrics'].get('gap_seconds', 8.0)))

        if card:
            # Spend the space on the cover instead. When a lyric *is* live it
            # gets the full width - readability of the words beats decoration.
            art = None
            if cfg['lyrics'].get('album_art', True) and st.get('cover_file'):
                side = int(cfg['lyrics'].get('art_size', 34))
                art = self._thumb(st['cover_file'], (side, side),
                                  cfg['lyrics'].get('art_mode', 'auto'))
            x0 = 3
            if art is not None:
                img.paste(art, (3, 3))
                x0 = 41
            tw = WIDTH - x0 - 3
            base = cfg['fonts']['lyric_size']
            sizes = [base, base - 1, base - 2, base - 3]
            small_h = line_height(small) if artist else 0
            placed = layout_text(title, tw, 36 - small_h, f, sizes, max_lines=2)
            y = 2
            if placed:
                rows, font, lh = placed
                y += max(0, (36 - small_h - lh * len(rows)) // 2)
                for row in rows:
                    draw_text(img, (x0, y), row, font)
                    y += lh
            else:
                draw_text(img, (x0, y), fit(title, tw, lyric_font), lyric_font)
                y += line_height(lyric_font)
            if artist:
                draw_text(img, (x0, min(y, 36 - small_h)),
                          fit(artist, tw, small), small)
        else:
            # Wrapped text beats scaled-up text: the line sits still and can be
            # read at a glance. Pick the largest font and fewest rows that fit;
            # a lyric too big for the space below the header takes the header's
            # row too, because the lyric is the point and the title is not.
            # Scrolling is the last resort - motion is worse than smaller type.
            base = cfg['fonts']['lyric_size']
            sizes = [base, base - 1, base - 2, base - 3]
            # 36 rows of pixels (0..35) sit above the progress bar at y=36.
            # This must not be 35: three 12px rows need exactly 36, and being
            # one pixel short silently downgraded long lyrics to a truncation.
            body_bottom = 36
            header_h = line_height(small)

            placed = layout_text(line, avail, body_bottom - header_h,
                                 f, sizes) if line else None
            show_header = placed is not None
            if line and placed is None:
                placed = layout_text(line, avail, body_bottom, f, sizes)

            if show_header:
                # Static, not a marquee: motion up here fights the lyric for
                # attention, and you end up staring at a fragment like
                # "- Dark Necessities". Title alone if the pair won't fit.
                combined = (f'{artist} - {title}' if artist and title
                            else (title or artist))
                header = (combined if text_width(combined, small) <= avail
                          else fit(title or artist, avail, small))
                draw_centered(img, 0, header, small)

            if placed:
                rows, font, lh = placed
                block = lh * len(rows)
                top = header_h if show_header else 0
                room = (body_bottom - top) - block
                top += max(0, room // 2)
                for i, row in enumerate(rows):
                    draw_centered(img, top + i * lh, row, font)
            elif line:
                draw_centered(img, 14, fit(line, avail, lyric_font), lyric_font)

        dur = st.get('duration') or 0
        if dur > 0:
            frac = max(0.0, min(1.0, pos / dur))
            d = ImageDraw.Draw(img)
            d.line([(2, 38), (WIDTH - 3, 38)], fill=1)          # track
            if frac > 0:                                         # elapsed
                d.rectangle([2, 36, 2 + int((WIDTH - 5) * frac), 38], fill=1)
        return img


class IdleSource(Source):
    """Capacity bars over CPU and GPU rows. The default when nothing claims it."""
    name = 'idle'
    fps = 1.0

    # Column right-edges. Values are right-aligned to these so a jump from
    # 99W to 118W doesn't shove the row sideways. Margins are 3/125 rather
    # than 2/126 to survive the +/-2 px burn-in shift without clipping.
    COL_TEMP, COL_UTIL, COL_WATT = 57, 91, 125

    BAR_LABELS = {'ram': 'RAM', 'vram': 'VRM', 'swap': 'SWP', 'disk': 'DSK'}

    def _bar_frac(self, kind):
        s = self.ctx.s
        if kind == 'ram':
            m = s.mem()
            return (m[0] / m[1]) if m else None
        if kind == 'vram':
            g = s.gpu()
            t = g.get('vram_total')
            return (g['vram_used'] / t) if t else None
        if kind == 'swap':
            sw = s.swap()
            return (sw[0] / sw[1]) if sw and sw[1] else None
        if kind == 'disk':
            try:
                st = os.statvfs(os.path.expanduser('~'))
                return 1.0 - (st.f_bavail / st.f_blocks) if st.f_blocks else None
            except OSError:
                return None
        return None

    def render(self, now):
        s, f = self.ctx.s, self.ctx.fonts
        ui = f.get(self.ctx.cfg['fonts']['ui_size'])
        img = Image.new('1', (WIDTH, HEIGHT), 0)
        gpu = s.gpu()
        rows = row_steps(ui, 3)

        # Top row: capacity bars. Bars beat numbers for "how full is it".
        kinds = self.ctx.cfg['idle'].get('bars', ['ram', 'vram'])[:2]
        half = WIDTH // 2
        for i, kind in enumerate(kinds):
            label = self.BAR_LABELS.get(kind, kind[:3].upper())
            x = 3 + i * half
            draw_text(img, (x, rows[0]), label, ui)
            lw = text_width(label, ui)
            draw_bar(img, (x + lw + 3, 2, x + half - 6, 8), self._bar_frac(kind))

        def row(y, label, temp, util, watts):
            draw_text(img, (3, y), label, ui)
            draw_right(img, self.COL_TEMP, y,
                       f'{temp:.0f}c' if temp is not None else '--', ui)
            draw_right(img, self.COL_UTIL, y,
                       f'{util:.0f}%' if util is not None else '--', ui)
            draw_right(img, self.COL_WATT, y,
                       f'{watts:.0f}W' if watts is not None else '--', ui)

        row(rows[1], 'CPU', s.cpu_temp(), s.cpu_util(), s.cpu_watts())
        # An asleep dGPU reports nothing rather than being woken up for a readout.
        row(rows[2], 'GPU', gpu.get('temp'), gpu.get('util'), gpu.get('watts'))
        return img


