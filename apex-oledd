class Context:
    """Shared daemon state handed to every source."""

    def __init__(self, cfg):
        self.cfg = cfg
        self.s = Sensors()
        self.fonts = Fonts(cfg)
        self.stop = threading.Event()
        self.current_source = None
        self.blanked = False
        self.blank_reason = None    # while blanked: what should_blank() said
        self.presence = None        # Presence, unless afk_minutes is 0
        self.device_error = None    # set while the panel cannot be opened
        self.forced_mode = None     # source name pinned by a hotkey, or None
        self.blank_override = False
        self.do_action = lambda action: None    # set once sources exist
        self.released_until = 0.0   # panel handed to another process until then
        self.notify = None
        self.sources = []

    def render_lines(self, lines, align='left', size=None):
        """Text frame used for CLI notifications."""
        font = self.fonts.get(size or self.cfg['fonts']['ui_size'])
        img = Image.new('1', (WIDTH, HEIGHT), 0)
        lines = [str(x) for x in lines][:4]
        if not lines:
            return img
        lh = line_height(font) + 1
        y = max(0, (HEIGHT - lh * len(lines)) // 2)
        for line in lines:
            if align == 'center':
                draw_centered(img, y, line, font)
            elif align == 'right':
                draw_right(img, WIDTH - 3, y, line, font)
            else:
                draw_text(img, (3, y), line, font)
            y += lh
        return img

    def should_blank(self, now=None):
        """Why the panel should be dark - 'manual', 'locked', 'idle' or
        'away' - or None to draw as normal.

        Manual and locked are absolute. The two absence reasons give way to a
        frame pushed over the socket: it was asked for explicitly and expires
        on its own, and then the panel goes dark again - a notification does
        not count as someone being here.

        'idle' is logind's IdleHint, which GNOME sets and KDE never does;
        'away' is evdev input via Presence, which works anywhere the user is
        in the `input` group. Either is enough.
        """
        if self.blank_override:
            return 'manual'
        d, sess = self.cfg['display'], self.s.session()
        if d.get('blank_on_lock', True) and sess.get('locked'):
            return 'locked'
        why = None
        if d.get('blank_on_idle', False) and sess.get('idle'):
            why = 'idle'
        elif self.presence is not None and self.presence.away():
            why = 'away'
        if why and self.notify is not None and self.notify.active(
                time.time() if now is None else now):
            return None
        return why


def compose(frame, now, cfg):
    """Apply the burn-in pixel shift."""
    radius = cfg['display'].get('burnin_shift', 2)
    period = cfg['display'].get('burnin_period', 611.0)
    if radius <= 0:
        return frame
    ang = 2 * math.pi * (now % period) / period
    dx = int(round(radius * math.cos(ang)))
    dy = int(round((radius / 2) * math.sin(2 * ang)))
    out = Image.new('1', (WIDTH, HEIGHT), 0)
    out.paste(frame, (dx, dy))
    return out


def build_sources(ctx):
    ctx.notify = NotifySource(ctx)
    sources = [ctx.notify, GameSource(ctx), QwenSource(ctx),
               VideoSource(ctx), LyricsSource(ctx), IdleSource(ctx)]
    return sorted(sources, key=lambda s: -s.priority)


# Order the `cycle` hotkey steps through. 'auto' means normal arbitration.
CYCLE_MODES = ['auto', 'idle', 'lyrics', 'qwen', 'game']


def make_action_handler(ctx, log=lambda m: None):
    """Turn a hotkey action string into a change of daemon state."""

    def feedback(text):
        # Confirm on the panel itself - the keys are silent otherwise, and
        # notify outranks everything so it shows even over a forced mode.
        img = ctx.render_lines([text], align='center',
                               size=ctx.cfg['fonts']['lyric_size'])
        ctx.notify.push(img, 1.2)

    def handle(action):
        action = str(action)
        if action == 'blank':
            ctx.blank_override = not ctx.blank_override
            log(f'hotkey: panel {"off" if ctx.blank_override else "on"}')
            if not ctx.blank_override:
                feedback('PANEL ON')
            return
        if action == 'cycle':
            have = [m for m in CYCLE_MODES
                    if m == 'auto' or any(s.name == m for s in ctx.sources)]
            cur = ctx.forced_mode or 'auto'
            nxt = have[(have.index(cur) + 1) % len(have)] if cur in have else 'auto'
        elif action.startswith('mode:'):
            nxt = action.split(':', 1)[1] or 'auto'
        else:
            log(f'hotkey: unknown action {action!r}')
            return
        ctx.forced_mode = None if nxt == 'auto' else nxt
        ctx.blank_override = False
        log(f'hotkey: mode -> {nxt}')
        feedback(nxt.upper() if nxt != 'auto' else 'AUTO')

    return handle


def run(args):
    cfg = load_config(args.config)
    ctx = Context(cfg)
    ctx.sources = build_sources(ctx)
    if args.only:
        wanted = set(args.only.split(','))
        ctx.sources = [s for s in ctx.sources if s.name in wanted]
        if not ctx.sources:
            sys.exit(f'apex-oledd: no such source: {args.only}')

    if args.preview:
        time.sleep(1.2)     # let the sensor baselines settle so the frame is real
        now = time.time()
        src = next((s for s in ctx.sources if s.active(now)), ctx.sources[-1])
        frame = compose(src.render(now) or Image.new('1', (WIDTH, HEIGHT), 0),
                        now, cfg)
        frame.convert('L').resize((WIDTH * 4, HEIGHT * 4),
                                  Image.NEAREST).save(args.preview)
        print(f'{src.name} -> {args.preview}')
        ctx.s.close()
        return

    try:
        server = Server(ctx)
    except RuntimeError:
        # Exit 3 is the "another instance owns the panel" contract that
        # apex-oledd-supervise uses to stop rather than restart-loop.
        print('apex-oledd: already running', file=sys.stderr)
        sys.exit(3)
    server.start()

    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, lambda *_: ctx.stop.set())

    def log(msg):
        if args.verbose:
            print(msg, flush=True)

    ctx.do_action = make_action_handler(ctx, log)
    if cfg['hotkeys'].get('enabled', True):
        keys = Hotkeys(ctx, ctx.do_action)
        if keys.mod and keys.bindings:
            log(f'hotkeys: {keys.find_keyboard()} '
                f'{cfg["hotkeys"]["modifier"]}+{",".join(sorted(k for k in cfg["hotkeys"]["bindings"]))}')
            keys.start()
        else:
            log('hotkeys: nothing bound')

    try:
        afk = float(cfg['display'].get('afk_minutes') or 0)
    except (TypeError, ValueError):
        afk = DEFAULTS['display']['afk_minutes']
    if afk > 0:
        ctx.presence = Presence(ctx, afk, cfg['display'].get('afk_ignore') or (),
                                log)
        ctx.presence.start()
        log(f'afk: blanking after {afk:g} min without input')

    dpy, last_fb = None, None
    fails, since = 0, 0.0
    while not ctx.stop.is_set():
        now = time.time()
        try:
            def healthy():
                """Called once a write has actually landed on the panel.

                Recovery is judged on a successful *write*, not a successful
                open(): a half-detached device still opens fine and only fails
                at the ioctl, which flapped back/unavailable once per retry.
                """
                nonlocal fails
                if fails:
                    log(f'device back after {fails} attempts '
                        f'({time.time() - since:.0f}s without it): {dpy.path}')
                fails, ctx.device_error = 0, None

            if now < ctx.released_until:
                # Another process owns the panel; drop our handle so it can
                # write, and idle until the lease expires. Checked before the
                # open below, or we would open and close once per tick.
                if dpy is not None:
                    try:
                        dpy.close()
                    except OSError:
                        pass
                    dpy, last_fb = None, None
                    log('panel released to another process')
                ctx.stop.wait(0.25)
                continue

            if dpy is None:
                dpy = apex.Display(args.device)
                last_fb = None
                if not fails:
                    log(f'opened {dpy.path}')

            why = ctx.should_blank(now)
            if why:
                if not ctx.blanked:
                    dpy.blank()
                    healthy()
                    last_fb, ctx.blanked = None, True
                    log(f'blanked ({why})')
                ctx.blank_reason = why
                ctx.stop.wait(1.0)
                continue
            if ctx.blanked:
                log('unblanked')
            ctx.blanked, ctx.blank_reason = False, None

            # notify always wins (it is the hotkey's own confirmation), then a
            # mode pinned by a hotkey, then normal arbitration.
            src = ctx.notify if ctx.notify.active(now) else None
            if src is None and ctx.forced_mode:
                src = next((s for s in ctx.sources
                            if s.name == ctx.forced_mode), None)
            auto = next((s for s in ctx.sources if s.active(now)), None)
            if src is None:
                src = auto
            if src is None:
                ctx.stop.wait(0.5)
                continue
            if src.name != ctx.current_source:
                log(f'source -> {src.name}')
            ctx.current_source = src.name

            frame = src.render(now)
            if frame is None and src is not auto and auto is not None:
                # A pinned source with nothing to draw (lyrics with no music,
                # say) must not leave the panel frozen on a stale frame.
                src, frame = auto, auto.render(now)
            if frame is not None:
                # Sources may return a ready-made framebuffer (video frames are
                # packed on disk); those skip compose, since full-motion video
                # needs no burn-in shift.
                fb = (frame if isinstance(frame, (bytes, bytearray))
                      else apex.pack(compose(frame, now, cfg)))
                if fb != last_fb:          # skip identical redraws
                    dpy.send(fb)
                    last_fb = fb
                    healthy()
            ctx.stop.wait(1.0 / src.fps)
        except (OSError, RuntimeError) as e:
            # Log the transition, not every retry. Logging each attempt at a
            # flat 2s produced 19k identical lines (1.7 MB) over one evening
            # with the keyboard unplugged. After the first message this stays
            # quiet and only reports again at widening intervals.
            if fails == 0:
                since = now
                log(f'device unavailable ({e}); retrying quietly')
            elif fails in (30, 300, 3000):
                log(f'still no device after {fails} attempts '
                    f'({(now - since) / 60:.0f} min)')
            fails += 1
            ctx.device_error = str(e)
            if dpy is not None:
                try:
                    dpy.close()
                except OSError:
                    pass
            dpy = None
            # Back off 2s -> 30s: a keyboard that is unplugged for the evening
            # does not need probing every two seconds.
            ctx.stop.wait(min(2.0 * 2 ** min(fails - 1, 4), 30.0))

    ctx.s.close()
    if dpy is not None:
        try:
            dpy.blank()
            dpy.close()
        except OSError:
            pass


def main():
    p = argparse.ArgumentParser(
        prog='apex-oledd',
        description='Arbitration daemon for the Apex Pro Gen 3 OLED.')
    p.add_argument('--device', help='hidraw node (default: autodetect)')
    p.add_argument('--config', default=CONFIG_PATH, help='config TOML')
    p.add_argument('--only', metavar='NAMES',
                   help='restrict to these sources, comma-separated')
    p.add_argument('--preview', metavar='PNG',
                   help='render one frame to a PNG (4x) and exit; for testing')
    p.add_argument('-v', '--verbose', action='store_true')
    run(p.parse_args())


if __name__ == '__main__':
    main()
