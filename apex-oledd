# IPC
# ---------------------------------------------------------------------------

class Server(threading.Thread):
    """Unix socket accepting JSON commands, one per connection.

    Doubles as the single-instance lock: if binding fails because something is
    already listening, another daemon owns the panel.
    """

    def __init__(self, ctx, path=SOCKET_PATH):
        super().__init__(daemon=True)
        self.ctx = ctx
        self.path = path
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            self.sock.bind(path)
        except OSError:
            # Either a live daemon or a socket left behind by a crash.
            probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            try:
                probe.connect(path)
                raise RuntimeError('already running')
            except (ConnectionRefusedError, FileNotFoundError):
                os.unlink(path)
                self.sock.bind(path)
            finally:
                probe.close()
        self.sock.listen(4)
        self.sock.settimeout(0.5)

    def run(self):
        while not self.ctx.stop.is_set():
            try:
                conn, _ = self.sock.accept()
            except socket.timeout:
                continue
            except OSError:
                break
            with conn:
                try:
                    conn.settimeout(2.0)
                    data = b''
                    while b'\n' not in data and len(data) < 1 << 20:
                        chunk = conn.recv(4096)
                        if not chunk:
                            break
                        data += chunk
                    reply = self.handle(json.loads(data.decode() or '{}'))
                except (OSError, ValueError) as e:
                    reply = {'ok': False, 'error': str(e)}
                try:
                    conn.sendall((json.dumps(reply) + '\n').encode())
                except OSError:
                    pass
        try:
            self.sock.close()
            os.unlink(self.path)
        except OSError:
            pass

    def handle(self, msg):
        cmd = msg.get('cmd')
        notify = self.ctx.notify
        if cmd == 'notify':
            secs = float(msg.get('secs', 5.0))
            if msg.get('fb'):
                # Client-rendered frame: a packed 640-byte framebuffer, so any
                # client can push arbitrary pixels without us re-rendering.
                import base64
                img = apex.unpack(base64.b64decode(msg['fb']))
            elif msg.get('image'):
                img = Image.open(msg['image'])
            else:
                img = self.ctx.render_lines(msg.get('lines') or [],
                                            align=msg.get('align', 'left'),
                                            size=msg.get('size'))
            if msg.get('invert'):
                img = img.convert('L').point(lambda p: 255 - p).convert('1')
            notify.push(img, secs)
            return {'ok': True}
        if cmd == 'clear':
            notify.clear()
            return {'ok': True}
        if cmd == 'status':
            now = time.time()
            return {'ok': True, 'source': self.ctx.current_source,
                    'sources': [s.name for s in self.ctx.sources if s.active(now)],
                    'blanked': self.ctx.blanked,
                    'device_error': self.ctx.device_error}
        return {'ok': False, 'error': f'unknown command: {cmd!r}'}


