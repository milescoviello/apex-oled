class Sensors:
    """Cheap sysfs reads, plus a background poll for anything expensive.

    nvidia-smi costs ~200 ms and, worse, touching the dGPU keeps it awake. So
    it is only run when the card is already active, on its own thread, and the
    result is cached. loginctl and gamemoded ride along on the same thread.
    """
    SLOW_INTERVAL = 5.0

    def __init__(self):
        self._cpu_temp_path = None
        self._rapl = None
        self._last_energy = None
        self._last_cpu = None
        self._last_swap = None
        self._gpu = {}
        self._session = {}
        self._gamemode = False
        self._resolve()
        # Prime the counters so the first frame has a baseline to differentiate
        # against instead of showing blanks.
        if self._rapl:
            uj = self._read(self._rapl, int)
            if uj is not None:
                self._last_energy = (time.time(), uj)
        self.cpu_util()
        self.swap_rate()
        self._stop = threading.Event()
        self._thread = threading.Thread(target=self._slow_loop, daemon=True)
        self._thread.start()

    def _resolve(self):
        for h in glob.glob('/sys/class/hwmon/hwmon*'):
            try:
                if open(h + '/name').read().strip() != 'coretemp':
                    continue
                for lbl in sorted(glob.glob(h + '/temp*_label')):
                    if open(lbl).read().strip() == 'Package id 0':
                        self._cpu_temp_path = lbl.replace('_label', '_input')
                        break
            except OSError:
                continue
        p = '/sys/class/powercap/intel-rapl:0/energy_uj'
        self._rapl = p if os.access(p, os.R_OK) else None

    @staticmethod
    def _read(path, cast=str, default=None):
        try:
            with open(path) as f:
                return cast(f.read().strip())
        except (OSError, ValueError):
            return default

    # --- fast paths (sysfs / procfs, called every frame) -------------------

    def cpu_temp(self):
        if not self._cpu_temp_path:
            self._resolve()
        v = self._read(self._cpu_temp_path, int) if self._cpu_temp_path else None
        return None if v is None else v // 1000

    def cpu_util(self):
        """Busy percentage across all cores, from /proc/stat deltas.

        iowait counts as idle, matching what top and btop report.
        """
        try:
            with open('/proc/stat') as f:
                parts = f.readline().split()
            vals = [int(x) for x in parts[1:11]]
        except (OSError, ValueError, IndexError):
            return None
        total, idle = sum(vals), vals[3] + vals[4]
        prev, self._last_cpu = self._last_cpu, (total, idle)
        if not prev:
            return None
        dt, di = total - prev[0], idle - prev[1]
        if dt <= 0:
            return None
        return max(0.0, min(100.0, 100.0 * (dt - di) / dt))

    def cpu_watts(self):
        """Package power from the RAPL energy counter, differentiated."""
        if not self._rapl:
            return None
        now, uj = time.time(), self._read(self._rapl, int)
        if uj is None:
            return None
        prev, self._last_energy = self._last_energy, (now, uj)
        if not prev:
            return None
        dt, duj = now - prev[0], uj - prev[1]
        if dt <= 0 or duj < 0:      # counter wrapped
            return None
        return duj / dt / 1e6

    def mem(self):
        """(used, total) in GiB, where used = MemTotal - MemAvailable.

        MemAvailable (not MemFree) is the honest figure: it already accounts
        for reclaimable cache, so this tracks what is actually committed.
        """
        total = avail = None
        try:
            with open('/proc/meminfo') as f:
                for line in f:
                    key, _, rest = line.partition(':')
                    if key == 'MemTotal':
                        total = int(rest.split()[0])
                    elif key == 'MemAvailable':
                        avail = int(rest.split()[0])
                        break
        except (OSError, ValueError, IndexError):
            return None
        if total is None or avail is None:
            return None
        return (total - avail) / 1048576.0, total / 1048576.0   # kB -> GiB

    def swap(self):
        """(used, total) in GiB."""
        total = free = None
        try:
            with open('/proc/meminfo') as f:
                for line in f:
                    key, _, rest = line.partition(':')
                    if key == 'SwapTotal':
                        total = int(rest.split()[0])
                    elif key == 'SwapFree':
                        free = int(rest.split()[0])
                        break
        except (OSError, ValueError, IndexError):
            return None
        if not total:
            return None
        return (total - free) / 1048576.0, total / 1048576.0

    def swap_rate(self):
        """(in, out) in MiB/s from /proc/vmstat page counters.

        This is the gaming-stutter signature: framerate collapses while the GPU
        sits idle because the machine is paging, and nothing on screen says so.
        """
        pin = pout = None
        try:
            with open('/proc/vmstat') as f:
                for line in f:
                    if line.startswith('pswpin '):
                        pin = int(line.split()[1])
                    elif line.startswith('pswpout '):
                        pout = int(line.split()[1])
        except (OSError, ValueError, IndexError):
            return None
        if pin is None or pout is None:
            return None
        now = time.time()
        prev, self._last_swap = self._last_swap, (now, pin, pout)
        if not prev:
            return None
        dt = now - prev[0]
        if dt <= 0:
            return None
        # pages -> MiB, assuming the usual 4 KiB page
        return (max(0, pin - prev[1]) * 4 / 1024 / dt,
                max(0, pout - prev[2]) * 4 / 1024 / dt)

    # --- slow paths (subprocess, polled on a thread) -----------------------

    def gpu_awake(self):
        for d in glob.glob('/sys/bus/pci/devices/*'):
            if (self._read(d + '/vendor') == '0x10de'
                    and self._read(d + '/class') == '0x030000'):
                return self._read(d + '/power/runtime_status') == 'active'
        return False

    def _poll_gpu(self):
        if not self.gpu_awake():
            self._gpu = {}
            return
        try:
            out = subprocess.run(
                ['nvidia-smi', '--query-gpu=temperature.gpu,power.draw,'
                 'utilization.gpu,memory.used,memory.total',
                 '--format=csv,noheader,nounits'],
                capture_output=True, text=True, timeout=5).stdout.strip()
            t, w, u, mu, mt = (x.strip() for x in out.split(',')[:5])
            self._gpu = {'temp': int(float(t)), 'watts': float(w),
                         'util': int(float(u)),
                         'vram_used': float(mu) / 1024.0,     # MiB -> GiB
                         'vram_total': float(mt) / 1024.0}
        except (OSError, ValueError, subprocess.SubprocessError):
            self._gpu = {}

    def _poll_session(self):
        """LockedHint/IdleHint for the graphical session, via logind."""
        try:
            sid = subprocess.run(['loginctl', 'show-user', str(os.getuid()),
                                  '-p', 'Display', '--value'],
                                 capture_output=True, text=True,
                                 timeout=5).stdout.strip()
            if not sid:
                # No "display" session recorded; fall back to the first session
                # that has a seat, which is the graphical one.
                out = subprocess.run(['loginctl', 'list-sessions', '--no-legend'],
                                     capture_output=True, text=True,
                                     timeout=5).stdout
                for line in out.splitlines():
                    parts = line.split()
                    if len(parts) >= 4 and parts[3].startswith('seat'):
                        sid = parts[0]
                        break
            if not sid:
                self._session = {}
                return
            out = subprocess.run(['loginctl', 'show-session', sid,
                                  '-p', 'LockedHint', '-p', 'IdleHint'],
                                 capture_output=True, text=True, timeout=5).stdout
            d = dict(l.split('=', 1) for l in out.strip().splitlines() if '=' in l)
            self._session = {'locked': d.get('LockedHint') == 'yes',
                             'idle': d.get('IdleHint') == 'yes'}
        except (OSError, ValueError, subprocess.SubprocessError):
            self._session = {}

    def _poll_gamemode(self):
        try:
            out = subprocess.run(['gamemoded', '-s'], capture_output=True,
                                 text=True, timeout=5).stdout
            self._gamemode = 'is active' in out
        except (OSError, subprocess.SubprocessError):
            self._gamemode = False

    def _slow_loop(self):
        first = True
        while first or not self._stop.wait(self.SLOW_INTERVAL):
            first = False
            if self._stop.is_set():
                break
            self._poll_gpu()
            self._poll_session()
            self._poll_gamemode()

    def gpu(self):
        return self._gpu

    def session(self):
        return self._session

    def gamemode(self):
        return self._gamemode

    def battery(self):
        return self._read('/sys/class/power_supply/BAT0/capacity', int)

    def headset(self):
        """Arctis battery, present only while the headset is powered on."""
        for p in glob.glob('/sys/class/power_supply/steelseries_headset_*'):
            v = self._read(p + '/capacity', int)
            if v is not None:
                return v
        return None

    def close(self):
        self._stop.set()


